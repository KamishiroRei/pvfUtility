<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behav="clr-namespace:UnitComboLib.Behaviour" xmlns:local="clr-namespace:UnitComboLib" xmlns:reskeys="clr-namespace:UnitComboLib.Themes">
  <ControlTemplate x:Key="UnitCmbComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Name="Border" Grid.ColumnSpan="2" Background="{TemplateBinding Control.Background}" BorderBrush="{DynamicResource UnitCmbNormalBorderBrushKey}" BorderThickness="0" />
      <Border Grid.Column="1" Margin="3" Background="#00FFFFFF" BorderBrush="#00FFFFFF">
        <Path Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" Fill="{DynamicResource UnitCmbGlyphBrushKey}" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="true" />
          <Condition Property="ToggleButton.IsChecked" Value="false" />
        </MultiTrigger.Conditions>
        <MultiTrigger.Setters>
          <Setter TargetName="Arrow" Value="{DynamicResource ControlAccentBrushKey}" Property="Shape.Fill" />
        </MultiTrigger.Setters>
      </MultiTrigger>
      <Trigger Property="ToggleButton.IsChecked" Value="true">
        <Setter TargetName="Border" Value="{DynamicResource UnitCmbPressedBrushKey}" Property="Border.Background" />
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Value="{DynamicResource UnitCmbDisabledBackgroundBrushKey}" Property="Control.Background" />
        <Setter Value="{DynamicResource UnitCmbDisabledBorderBrushKey}" Property="Control.BorderBrush" />
        <Setter Value="{DynamicResource UnitCmbDisabledForegroundBrushKey}" Property="Control.Foreground" />
        <Setter TargetName="Arrow" Value="{DynamicResource UnitCmbDisabledForegroundBrushKey}" Property="Shape.Fill" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
    <Border Name="PART_ContentHost" VerticalAlignment="Center" Background="{TemplateBinding Control.Background}" Focusable="False" />
  </ControlTemplate>
  <Style x:Key="{x:Type local:UnitCombobox}" TargetType="{x:Type local:UnitCombobox}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="true" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource NormalBackgroundBrushKey}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:UnitCombobox}">
          <Border Name="ControlBorder" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Name="PART_MeasureTextBox" Grid.Column="0" Margin="3,0,1,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Stretch" Focusable="False" IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}" Visibility="Hidden" Template="{StaticResource ComboBoxTextBox}" Text="{Binding MaxStringLengthValue, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
              <ContentPresenter Name="ContentSite" Grid.Column="0" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" IsHitTestVisible="False" />
              <TextBox Name="PART_EditableTextBox" Grid.Column="0" Margin="3,0,1,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Right" VerticalContentAlignment="Stretch" Focusable="True" IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}" Visibility="Hidden" Template="{StaticResource ComboBoxTextBox}" Width="{Binding ElementName=PART_MeasureTextBox, Path=Width}" />
              <Grid Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="1" Grid.Column="0" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" behav:ContextMenuBehaviour.MenuList="{Binding ElementName=contextMenuOnUniLabel1}" ToolTip="{Binding SelectedItem.DisplayNameLong}">
                  <FrameworkElement.ContextMenu>
                    <ContextMenu Name="contextMenuOnUniLabel1" Placement="Top" ItemsSource="{Binding Path=UnitList}">
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type MenuItem}">
                          <Setter Property="MenuItem.Command" Value="{Binding Path=DataContext.SetSelectedItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                          <Setter Property="MenuItem.CommandParameter" Value="{Binding Key}" />
                          <Setter Property="Header" Value="{Binding DisplayNameLongWithShort}" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                  <TextBlock Name="LabelTextBlock" Text="{Binding SelectedItem.DisplayNameShort}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="true">
                            <Setter Property="TextDecorations" Value="Underline" />
                            <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </Label>
                <ToggleButton Name="ToggleButton" Grid.Column="1" Margin="0" Padding="0" VerticalAlignment="Stretch" ClickMode="Press" Focusable="false" Template="{StaticResource UnitCmbComboBoxToggleButton}" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
              <Popup Name="Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                <Grid Name="DropDown" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True">
                  <Border Name="DropDownBorder" Background="{DynamicResource UnitCmbWindowBackgroundBrushKey}" BorderBrush="{DynamicResource UnitCmbSolidBorderBrushKey}" BorderThickness="1" />
                  <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Grid>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ControlBorder" Value="{DynamicResource UnitCmbHighlighColorBrushKey}" Property="Border.BorderBrush" />
              <Setter TargetName="ControlBorder" Property="Border.BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="ItemsControl.HasItems" Value="false">
              <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter Value="{DynamicResource UnitCmbDisabledForegroundBrushKey}" Property="Foreground" />
            </Trigger>
            <Trigger Property="ItemsControl.IsGrouping" Value="true">
              <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
            </Trigger>
            <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="true">
              <Setter TargetName="DropDownBorder" Property="Margin" Value="0,2,0,0" />
            </Trigger>
            <Trigger Property="ComboBox.IsEditable" Value="true">
              <Setter Property="IsTabStop" Value="false" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>