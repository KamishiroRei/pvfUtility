<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:reskeys="clr-namespace:UnitComboLib.Themes">
  <Color x:Key="{ComponentResourceKey ResourceId=ControlAccentColorKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}">#FF1888b8</Color>
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=ControlAccentBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="Blue" />
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=NormalBackgroundBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#FFFFFFFF" />
  <LinearGradientBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbDarkBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" StartPoint="0,0" EndPoint="0,1">
    <GradientBrush.GradientStops>
      <GradientStopCollection>
        <GradientStop Offset="0.0" Color="#FFF" />
        <GradientStop Offset="1.0" Color="#AAA" />
      </GradientStopCollection>
    </GradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbHighlighColorBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="{DynamicResource {x:Static reskeys:ResourceKeys.ControlAccentColorKey}}" />
  <LinearGradientBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbPressedBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" StartPoint="0,0" EndPoint="0,1">
    <GradientBrush.GradientStops>
      <GradientStopCollection>
        <GradientStop Offset="0.0" Color="#BBB" />
        <GradientStop Offset="0.1" Color="#EEE" />
        <GradientStop Offset="0.9" Color="#EEE" />
        <GradientStop Offset="1.0" Color="#FFF" />
      </GradientStopCollection>
    </GradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbDisabledForegroundBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#888" />
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbDisabledBackgroundBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#EEE" />
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbWindowBackgroundBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#FFF" />
  <LinearGradientBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbNormalBorderBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" StartPoint="0,0" EndPoint="0,1">
    <GradientBrush.GradientStops>
      <GradientStopCollection>
        <GradientStop Offset="0.0" Color="#CCC" />
        <GradientStop Offset="1.0" Color="#444" />
      </GradientStopCollection>
    </GradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbDisabledBorderBrush, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#AAA" />
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbSolidBorderBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#888" />
  <SolidColorBrush x:Key="{ComponentResourceKey ResourceId=UnitCmbGlyphBrushKey, TypeInTargetAssembly={x:Type reskeys:ResourceKeys}}" Color="#444" />
</ResourceDictionary>