<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:editing="clr-namespace:ICSharpCode.AvalonEdit.Editing;assembly=ICSharpCode.AvalonEdit" xmlns:local="clr-namespace:TextEditLib" xmlns:rendering="clr-namespace:ICSharpCode.AvalonEdit.Rendering;assembly=ICSharpCode.AvalonEdit" xmlns:reskeys="clr-namespace:TextEditLib.Themes">
  <Style x:Key="{x:Type editing:LineNumberMargin}" TargetType="{x:Type editing:LineNumberMargin}">
    <Setter Property="Margin" Value="15,0,15,0" />
  </Style>
  <Style x:Key="{x:Type local:TextEditDefault}" TargetType="{x:Type local:TextEditDefault}">
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="Background" Value="{DynamicResource EditorBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource EditorForeground}" />
    <Setter Property="avalonEdit:TextEditor.LineNumbersForeground" Value="{DynamicResource EditorLineNumbersForeground}" />
    <Setter Property="local:TextEditDefault.EditorCurrentLineBackground" Value="{DynamicResource EditorCurrentLineBackgroundBrushKey}" />
    <Setter Property="local:TextEditDefault.EditorCurrentLineBorder" Value="{DynamicResource EditorCurrentLineBorderBrushKey}" />
    <Setter Property="FrameworkElement.ContextMenu">
      <Setter.Value>
        <ContextMenu>
          <MenuItem Command="Cut" Header="剪切">
            <MenuItem.Icon>
              <Image Height="16" SnapsToDevicePixels="True" Source="{DynamicResource Image_Cut}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="Copy" Header="复制">
            <MenuItem.Icon>
              <Image Height="16" SnapsToDevicePixels="True" Source="{DynamicResource Image_Copy}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="Paste" Header="粘贴">
            <MenuItem.Icon>
              <Image Height="16" SnapsToDevicePixels="True" Source="{DynamicResource Image_Paste}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="Delete" Header="删除">
            <MenuItem.Icon>
              <Image Height="16" SnapsToDevicePixels="True" Source="{DynamicResource Image_Delete}" />
            </MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Command="Undo" Header="撤销">
            <MenuItem.Icon>
              <Image Height="16" SnapsToDevicePixels="True" Source="{DynamicResource Image_Undo}" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Command="Redo" Header="重做">
            <MenuItem.Icon>
              <Image Height="16" SnapsToDevicePixels="True" Source="{DynamicResource Image_Redo}" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:TextEditDefault}">
          <FrameworkTemplate.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type rendering:TextView}" TargetType="{x:Type rendering:TextView}">
                <Setter Property="rendering:TextView.NonPrintableCharacterBrush" Value="{DynamicResource EditorNonPrintableCharacterBrush}" />
                <Setter Property="rendering:TextView.LinkTextForegroundBrush" Value="{DynamicResource EditorLinkTextForegroundBrush}" />
                <Setter Property="rendering:TextView.LinkTextBackgroundBrush" Value="{DynamicResource EditorLinkTextBackgroundBrush}" />
              </Style>
              <Style x:Key="{x:Type editing:TextArea}" TargetType="{x:Type editing:TextArea}">
                <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="editing:TextArea.SelectionBrush" Value="{DynamicResource EditorSelectionBrush}" />
                <Setter Property="editing:TextArea.SelectionBorder">
                  <Setter.Value>
                    <Pen Brush="{DynamicResource {x:Static reskeys:ResourceKeys.EditorSelectionBorder}}" Thickness="1" />
                  </Setter.Value>
                </Setter>
                <Setter Property="editing:TextArea.SelectionCornerRadius" Value="0" />
                <Setter Property="editing:TextArea.SelectionForeground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type editing:TextArea}">
                      <DockPanel Focusable="False">
                        <ItemsControl DockPanel.Dock="Left" Focusable="False" ItemsSource="{Binding Path=LeftMargins, RelativeSource={RelativeSource TemplatedParent}}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ContentPresenter Panel.ZIndex="-1" Focusable="False" Content="{Binding Path=TextView, RelativeSource={RelativeSource TemplatedParent}}" />
                      </DockPanel>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ResourceDictionary>
          </FrameworkTemplate.Resources>
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
            <ScrollViewer Name="PART_ScrollViewer" Padding="{TemplateBinding Control.Padding}" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Content="{Binding Path=TextArea, RelativeSource={RelativeSource TemplatedParent}}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="avalonEdit:TextEditor.WordWrap" Value="True">
              <Setter TargetName="PART_ScrollViewer" Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>