        <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=EditConfig.NowEditorHighlightingColorOption.Digits, Mode=OneTime}" Text="{Binding Count}" />
