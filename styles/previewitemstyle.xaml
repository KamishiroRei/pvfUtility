        <FocusBehavior xmlns="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" />
        <EventToCommand p20:EventTriggerBase.EventName="Loaded" p21:EventToCommandBase.Command="{Binding OnPreviewLoadedCommand}" xmlns:p21="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" xmlns:p20="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1" xmlns="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" />
      </dxmvvm:Interaction.Behaviors>
      <Grid>
        <Border Width="310" Height="453" Background="#171d28" Opacity="0.95">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Border BorderBrush="#65552d" BorderThickness="2.5">
              <Grid>
                <Grid Name="gridHeader" Width="310" Height="21">
                  <Image Source="/images/pngs/npcshop/46.png" Stretch="Fill" />
                  <Image Source="/images/pngs/npcshop/47.png" Stretch="Fill" />
                  <Label HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFFFF" Content="{Binding NpcName}" />
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Row="1" BorderBrush="#46372f" BorderThickness="1,0,1,1" CornerRadius="0,0,3,3">
              <Border Grid.Row="1" BorderBrush="#65552d" BorderThickness="2.5,0,2.5,2.5" CornerRadius="0,0,3,3">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Border Width="280" Margin="0,5,0,0" BorderBrush="#FF000000" BorderThickness="0">
                    <Image Height="60" Source="/images/pngs/npcshop/npcshopheader.png" Stretch="Fill" />
                  </Border>
                  <TabControl Grid.Row="1" Margin="15,10,15,64" ContentTemplate="{StaticResource NpcShopContentTemplate}" ItemTemplate="{StaticResource NpcShopTabItemHeaderTemplate}" Style="{StaticResource NpcShopTabControlStyle}" ItemsSource="{Binding Items.CollectionView}">
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
                          <Setter Property="TabItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type TabItem}">
                                <Grid Width="67" Height="20">
                                  <Image Name="img" Width="67" Height="20" />
                                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#c7b185" Text="{Binding Title}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="False">
                                    <Setter TargetName="img" Property="Image.Source" Value="/images/pngs/npcshop/86.png" />
                                  </Trigger>
                                  <Trigger Property="TabItem.IsSelected" Value="True">
                                    <Setter TargetName="img" Property="Image.Source" Value="/images/pngs/npcshop/88.png" />
                                  </Trigger>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="img" Property="Image.Source" Value="/images/pngs/npcshop/87.png" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                  </TabControl>
                </Grid>
              </Border>
            </Border>
          </Grid>
        </Border>
        <Image Width="39" Height="39" Margin="-5,-10,0,0" HorizontalAlignment="Left" VerticalAlignment="top" Source="/images/pngs/npcshop/48.png" Stretch="Fill" />
        <editors:HyperlinkEdit FrameworkElement.Margin="10,0,0,10" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Bottom" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:HyperlinkEdit.AllowAutoNavigate="True" editors:BaseEdit.EditValue="使用Npc商店设计器打开" Control.FontFamily="微软雅黑" editors:HyperlinkEdit.Command="{Binding OnOpenNpcShopEditorCommand}" />
      </Grid>
    </ContentControl>
  </DataTemplate>
  <preview:PvfFilePreviewContentTemplateSelector x:Key="PvfFilePreviewContentTemplateSelector" Equipment="{StaticResource Preview_DataTemplate_EQU_armor}" NpcShop="{StaticResource NpcShopPreviewPanel}" StackableDefaultTemplate="{StaticResource StkablePreviewDefault}" Stackable_附魔卡片="{StaticResource Stackable_附魔卡片}" Stkable_设计图="{StaticResource Stkable_设计图}" />
  <Style x:Key="ItemPreviewToolTipStyle" TargetType="{x:Type ToolTip}">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="BorderBrush" Value="{x:Null}" />
    <Setter Property="Background" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</ResourceDictionary>
