<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:gmtool="clr-namespace:PvfCode.Converts.GMTool;assembly=pvfUtility" xmlns:pvfcode="clr-namespace:PvfCode;assembly=pvfUtility">
  <gmtool:ConverterJobAvatar x:Key="ConverterJobAvatar" />
  <gmtool:ConverterTopUpValueType x:Key="ConverterTopUpValueType" />
  <gmtool:ConverterTopUpType x:Key="ConverterTopUpType" />
  <gmtool:ConverterPostalType x:Key="ConverterPostalType" />
  <gmtool:ConverterAmplify_optionStyle x:Key="ConverterAmplify_optionStyle" />
  <Style x:Key="CharacJobImageStyle2" TargetType="{x:Type Image}">
    <Setter Property="Source" Value="{Binding Row, Mode=OneWay, Converter={StaticResource ConverterJobAvatar}}" />
  </Style>
  <Style x:Key="ItemNameRarity" BasedOn="{StaticResource treeCellTextBlack}" TargetType="{x:Type TextBlock}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Row.Rarity}" Value="{x:Null}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.ItemNameBrush}" />
      </DataTrigger>
      <DataTrigger Value="0" Binding="{Binding Row.Rarity}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.RarityColor0}" />
      </DataTrigger>
      <DataTrigger Value="1" Binding="{Binding Row.Rarity}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.RarityColor1}" />
      </DataTrigger>
      <DataTrigger Value="2" Binding="{Binding Row.Rarity}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.RarityColor2}" />
      </DataTrigger>
      <DataTrigger Value="3" Binding="{Binding Row.Rarity}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.RarityColor3}" />
      </DataTrigger>
      <DataTrigger Value="4" Binding="{Binding Row.Rarity}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.RarityColor4}" />
      </DataTrigger>
      <DataTrigger Value="5" Binding="{Binding Row.Rarity}">
        <Setter Property="Foreground" Value="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.NowTreeColorConfig.RarityColor5}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>