<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:root="clr-namespace:PvfCode;assembly=pvfUtility">
  <DataTemplate x:Key="DocumentNavigationBackBarCheckTemplate">
    <ContentControl>
      <bars:BarCheckItem xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:BarCheckItem.GroupIndex="1" bars:BarItem.Command="{Binding OnClickCommand}" bars:BarItem.Content="{Binding}" bars:BarCheckItem.IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <bars:BarItem.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
              <TextBlock Text="{Binding FilePath}" />
              <Label Visibility="{Binding TextVisibility, Converter={StaticResource ConvertBoolenToVisibility}}">：</Label>
              <TextBlock Name="textDocumentText" Foreground="#FF808080" Text="{Binding Text}" Visibility="{Binding TextVisibility, Converter={StaticResource ConvertBoolenToVisibility}}" />
              <StackPanel Margin="10,0,0,0" Orientation="Horizontal" Visibility="{Binding TextVisibility, Converter={StaticResource ConvertBoolenFalseToVisibility}}">
                <Label Foreground="#FF808080">行：</Label>
                <TextBlock Foreground="#FF808080" Text="{Binding Line}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </bars:BarItem.ContentTemplate>
      </bars:BarCheckItem>
    </ContentControl>
  </DataTemplate>
  <DataTemplate x:Key="subPvfOpenLogItemTemplate">
    <ContentControl>
      <bars:BarButtonItem xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:BarItem.Command="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=BarsVm.OnOpenPvfFileCommand}" bars:BarItem.CommandParameter="{Binding Key}" bars:BarItem.Content="{Binding Key}" ContentElement.IsEnabled="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Converter={StaticResource ConverterBoolenToFalse}}" />
    </ContentControl>
  </DataTemplate>
  <DataTemplate x:Key="subBookMarkItemTemplate" />
  <DataTemplate x:Key="CustomNotificationTemplate">
    <Border Background="{DynamicResource WindowBackColor}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Background="#FF3D3D3D">
          <Image Stretch="Fill" Source="{Binding Icon}" />
        </Border>
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Margin="0,0,0,5" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource WindowForeground}" Text="{Binding Title}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource WindowForeground}" TextWrapping="Wrap" Text="{Binding Message}" />
            <editors:HyperlinkEdit Control.Padding="0,0,15,0" FrameworkElement.HorizontalAlignment="Right" FrameworkElement.VerticalAlignment="Center" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:HyperlinkEdit.AllowAutoNavigate="False" editors:HyperlinkEdit.Command="{Binding MethodsCommand}" editors:BaseEdit.EditValue="{Binding ButtonTitle}" UIElement.Visibility="{Binding ButtonVisibility}" />
            <HyperlinkEdit Control.Padding="0,0,15,0" FrameworkElement.HorizontalAlignment="Right" FrameworkElement.VerticalAlignment="Center" p13:HyperlinkEdit.AllowAutoNavigate="False" p13:HyperlinkEdit.Command="{Binding Command2}" p13:BaseEdit.EditValue="{Binding ButtonTitle}" UIElement.Visibility="{Binding ButtonVisibility2}" xmlns:p13="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" xmlns="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </DataTemplate>
  <Style x:Key="BarOpenPvfFileStyle" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnOpenPvfFileCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Converter={StaticResource ConverterBoolenToFalse}}" />
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_File_OpenPvfPack}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="Ctrl+O" />
    <Setter Property="dxb:BarItem.Glyph" Value="/images/svgs/openfolder_16x.svg" />
  </Style>
  <Style x:Key="BarSavePvfFileStyle" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnSavePvfFileCommand}" />
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_File_SavePvfPack}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="Ctrl+Shift+s" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="50" />
    <Setter Property="dxb:BarItem.Glyph" Value="{DynamicResource Save_16x}" />
  </Style>
  <Style x:Key="BarSaveAsPvfFileStyle" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnSavePvfFileAsCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen}" />
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_File_SavePvfPackAs}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="Ctrl+Alt+A" />
    <Setter Property="dxb:BarItem.Glyph" Value="{DynamicResource SaveAs_16x}" />
  </Style>
  <Style x:Key="BarRefTreeFileListStyle" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnRefTreeListCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen}" />
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_File_RefTreeList}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="ctrl+r" />
    <Setter Property="dxb:BarItem.Glyph" Value="{DynamicResource RefreshIcon}" />
  </Style>
  <Style x:Key="BarClosePvfFileStyle" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnClosePvfFileCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen}" />
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_File_CloseCurrentPvfPack}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="Ctrl+Alt+C" />
    <Setter Property="dxb:BarItem.Glyph" Value="/images/svgs/closepvf.svg" />
  </Style>
  <Style x:Key="BarExitStyle" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnExitCommand}" />
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_File_Exit}" />
    <Setter Property="dxb:BarItem.KeyTip" Value="X" />
  </Style>
  <Style x:Key="BarPublicSeearch" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_Search_GlobalSearch}" />
    <Setter Property="dxb:BarItem.Glyph" Value="/images/svgs/findinfiles_16x.svg" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="F3" />
    <Setter Property="dxb:BarItem.Command" Value="{Binding OnSearchPvfCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
  </Style>
  <Style x:Key="BarSeearchItemCodeTool" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_Search_CodeSearcher}" />
    <Setter Property="dxb:BarItem.Glyph" Value="{DynamicResource CodeIcon}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="F7" />
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnOpenWindowItemCodeSearchCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
  </Style>
  <Style x:Key="BarSeearchItemNameTool" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_Search_NameSearcher}" />
    <Setter Property="dxb:BarItem.Glyph" Value="{DynamicResource ItemName}" />
    <Setter Property="dxb:BarItem.KeyGesture" Value="F8" />
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnOpenWindowItemNameSearchCommand}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
  </Style>
  <Style x:Key="BarSeearchNpkTool" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_Search_NpkSearcher}" />
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnOpenNpkSearchPanelCommand}" />
  </Style>
  <Style x:Key="BarPvfRelease" TargetType="{x:Type dxb:BarButtonItem}">
    <Setter Property="dxb:BarItem.Content" Value="{DynamicResource mainWin_bar_Main_subItem_Tools_Publish}" />
    <Setter Property="dxb:BarItem.BarItemDisplayMode" Value="ContentAndGlyph" />
    <Setter Property="dxb:BarItem.Command" Value="{Binding BarsVm.OnPvfReleaseCommand}" />
    <Setter Property="dxb:BarItem.Glyph" Value="{DynamicResource PvfRelease}" />
    <Setter Property="ContentElement.IsEnabled" Value="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
  </Style>
</ResourceDictionary>