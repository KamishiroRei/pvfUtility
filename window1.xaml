<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PvfCode;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="NPC 商店布局预览" Width="800" Height="450" Topmost="True">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid>
    <Border Width="310" Height="453" Background="#171d28" Opacity="0.9">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Border BorderBrush="#65552d" BorderThickness="2.5">
          <Grid>
            <Grid Name="gridHeader" Width="310" Height="21">
              <Image Source="/images/pngs/npcshop/46.png" Stretch="Fill" />
              <Image Source="/images/pngs/npcshop/47.png" Stretch="Fill" />
              <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF">赛丽亚.克鲁敏</Label>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="1" BorderBrush="#46372f" BorderThickness="1,0,1,1" CornerRadius="0,0,3,3">
          <Border Grid.Row="1" BorderBrush="#65552d" BorderThickness="2.5,0,2.5,2.5" CornerRadius="0,0,3,3">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Width="280" Height="61" Margin="0,5,0,0" Background="#FF808080" BorderBrush="#FF000000" BorderThickness="1">
                <Label>鼠标拖动改变顺序</Label>
              </Border>
              <TabControl Grid.Row="1" Margin="10,10,10,18" Style="{StaticResource NpcShopTabControlStyle}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border>
                              <Grid>
                                <Image Name="img" Width="67" Height="20" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#c7b185" Text="{TemplateBinding HeaderedContentControl.Header}" />
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="False">
                                <Setter TargetName="img" Property="Image.Source" Value="/images/pngs/npcshop/86.png" />
                              </Trigger>
                              <Trigger Property="TabItem.IsSelected" Value="True">
                                <Setter TargetName="img" Property="Image.Source" Value="/images/pngs/npcshop/88.png" />
                              </Trigger>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="img" Property="Image.Source" Value="/images/pngs/npcshop/87.png" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <TabItem Header="商店" />
                <TabItem Header="预览">
                  <Label>布局预览</Label>
                </TabItem>
              </TabControl>
            </Grid>
          </Border>
        </Border>
      </Grid>
    </Border>
    <Image Width="39" Height="39" Margin="-5,-10,0,0" HorizontalAlignment="Left" VerticalAlignment="top" Source="/images/pngs/npcshop/48.png" Stretch="Fill" />
  </Grid>
</Window>
