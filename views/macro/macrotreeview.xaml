<?xml version="1.0" encoding="utf-8"?>
<macro:MacroTreeView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:local=" PvfCode.Views.Macro" xmlns:macro="clr-namespace:PvfCode.Views.Macro;assembly=pvfUtility" xmlns:macro1="clr-namespace:Converts.Macro;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mvvmservices="clr-namespace:PvfCode.MVVMServices;assembly=pvfUtility" xmlns:root="clr-namespace:PvfCode;assembly=pvfUtility" xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" grid:DataControlBase.SelectionMode="Row" grid:DataControlBase.SelectedItems="{Binding SelectedNodesBindBase, Mode=TwoWay}">
  <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
    <mvvmservices:TreeListService />
  </interactivity:Interaction.Behaviors>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <macro:MacroTreeNodeImageSelector x:Key="MacroTreeNodeImageSelector" />
      <macro1:ConverterUploadButtonTemplate x:Key="ConverterUploadButtonTemplate" />
      <DataTemplate x:Key="BookmarkRowTemplate">
        <StackPanel Name="stackPanel" Orientation="Horizontal">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <TextBlock Text="{Binding Row.Key, Mode=OneWay}" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="UploadButtonTemplate">
        <StackPanel Visibility="{Binding Row.Value.IsFile, Converter={StaticResource ConverterUploadButtonTemplate}}">
          <bars:ToolBarControl Grid.Column="3" FrameworkElement.VerticalAlignment="Center" xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:ToolBarControlBase.AllowCustomizationMenu="False" bars:ToolBarControl.AllowQuickCustomization="False" Control.Background="#00FFFFFF">
            <bars:BarButtonItem BarItem.Background="#00FFFFFF" BarItem.Content="{DynamicResource MacroTreeView_ShareMacro}" FrameworkContentElement.Cursor="Hand" BarItem.Glyph="{DynamicResource UploadIcon}" bars:BarItem.Command="{Binding Path=DataContext.OnUploadCommand, RelativeSource={RelativeSource AncestorType=dxg:TreeListControl}}" bars:BarItem.CommandParameter="{Binding Row}" />
          </bars:ToolBarControl>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <grid1:TreeListControl.Columns xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
    <grid1:TreeListColumn grid:BaseColumn.Name="columnKey" grid:BaseColumn.Width="*" ColumnBase.CellDisplayTemplate="{StaticResource BookmarkRowTemplate}" grid:ColumnBase.FieldName="Key" xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
    </grid1:TreeListColumn>
    <grid1:TreeListColumn grid:ColumnBase.AllowSorting="True" grid:ColumnBase.AllowedSortOrders="Ascending" grid:ColumnBase.FieldName="Value.Sort" grid:ColumnBase.SortIndex="1" grid:ColumnBase.SortMode="Default" grid:BaseColumn.Visible="False" />
    <grid1:TreeListColumn grid:BaseColumn.Width="auto" grid:ColumnBase.CellDisplayTemplate="{StaticResource UploadButtonTemplate}" />
  </grid1:TreeListControl.Columns>
  <TreeListControl.View xmlns="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
    <grid1:TreeListView xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1" grid1:TreeListView.Name="treeListView" FrameworkElement.Width="auto" grid1:TreeListView.AllowAdvancedHorizontalNavigation="False" grid1:TreeListView.AllowAdvancedVerticalNavigation="False" grid1:TreeListView.AllowBandMoving="False" grid1:TreeListView.AllowBandMultiRow="False" grid1:TreeListView.AllowBandResizing="False" grid1:TreeListView.AllowBestFit="False" grid1:TreeListView.AllowCascadeUpdate="False" grid1:TreeListView.AllowChildNodeSourceUpdates="False" grid:DataViewBase.AllowColumnFiltering="False" grid:DataViewBase.AllowEditing="False" grid1:TreeListView.AllowHorizontalScrollingVirtualization="True" grid1:TreeListView.AllowTreeIndentScrolling="False" grid1:TreeListView.AutoExpandAllNodes="False" grid1:TreeListView.AutoWidth="False" grid1:TreeListView.CompactPanelShowMode="CompactMode" grid1:TreeListView.FetchSublevelChildrenOnExpand="True" grid1:TreeListView.HorizontalScrollbarVisibility="Auto" grid:DataViewBase.IsDeferredScrolling="False" grid:DataViewBase.NavigationStyle="Row" grid1:TreeListView.NodeImageSelector="{StaticResource MacroTreeNodeImageSelector}" grid:DataViewBase.RowAnimationKind="None" grid:DataViewBase.ScrollingMode="Smart" grid1:TreeListView.ShowCheckboxes="False" grid:DataViewBase.ShowColumnHeaders="False" grid1:TreeListView.ShowExpandButtons="True" grid1:TreeListView.ShowHorizontalLines="False" grid1:TreeListView.ShowIndicator="False" grid1:TreeListView.ShowNodeImages="True" grid:DataViewBase.ShowSelectionRectangle="True" grid1:TreeListView.ShowVerticalLines="False" grid1:TreeListView.TreeColumnFieldName="Key" grid1:TreeListView.TreeDerivationMode="ChildNodesSelector" grid1:TreeListView.UseEvenRowBackground="False" grid1:TreeListView.VerticalScrollbarVisibility="Auto" grid1:TreeListView.ChildNodesSelector="{Binding ChildNodesSelector}" grid:DataViewBase.FocusedRow="{Binding SelectedNodeBindgBase, Mode=TwoWay}" grid1:TreeListView.RowDoubleClickCommand="{Binding NodeDoubleClickCommand}" grid1:TreeListView.ScrollBarAnnotationMode="{x:Null}">
      <bars:BarManager.DXContextMenu xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
        <bars:PopupMenu>
          <bars:PopupMenu.Items xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
            <bars:BarButtonItem bars:BarItem.CommandParameter="false" bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_NewDirectory}" bars:BarItem.Command="{Binding OnAddCommand}" bars:BarItem.Glyph="{Binding Source={x:Static root:Res.Instance}, Path=TreeFiles.FolderClosed}" />
            <bars:BarItemSeparator xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_ExpandAll}">
            </bars:BarButtonItem>
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_CollapseAll}">
            </bars:BarButtonItem>
            <bars:BarItemSeparator />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_MoveUp}" bars:BarItem.Glyph="{DynamicResource GoToUp}" bars:BarItem.Command="{Binding OnUpCommand}" bars:BarItem.KeyGesture="{Binding Source={x:Static root:KeyGestureStaticValue.Instance}, Path=AltAndUp}" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_MoveDown}" bars:BarItem.Glyph="{DynamicResource GoToDown}" bars:BarItem.Command="{Binding OnDownCommand}" bars:BarItem.KeyGesture="{Binding Source={x:Static root:KeyGestureStaticValue.Instance}, Path=AltAndDown}" />
            <bars:BarItemSeparator />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_Delete}" bars:BarItem.Glyph="{DynamicResource Action_Delete}" bars:BarItem.KeyGesture="Delete" bars:BarItem.Command="{Binding OnDeleteCommand}" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource MacroTreeView_GridData_ContextMenu_Rename}" bars:BarItem.Glyph="{DynamicResource EditComment}" bars:BarItem.KeyGesture="f2" bars:BarItem.Command="{Binding OnEditCommand}" />
          </bars:PopupMenu.Items>
        </bars:PopupMenu>
      </bars:BarManager.DXContextMenu>
    </grid1:TreeListView>
  </TreeListControl.View>
</macro:MacroTreeView>