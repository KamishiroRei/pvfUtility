<?xml version="1.0" encoding="utf-8"?>
<macro:WIndowSaveMacroData xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:i1="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1" xmlns:texteditlib="clr-namespace:TextEditLib;assembly=TextEditLib" xmlns:texteditorfolder="clr-namespace:PvfCode.Controls.TextEditorFolder;assembly=pvfUtility" Window.Title="{DynamicResource WindowSaveMacroData_Title}" FrameworkElement.Width="400" Control.Padding="10" Window.ResizeMode="NoResize" Window.SizeToContent="Height" Window.WindowStyle="ToolWindow" xmlns:macro="clr-namespace:PvfCode.Views.Macro;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <Grid IsEnabled="{Binding IsLoading, Converter={StaticResource ConverterBoolenToFalse}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <controls:EditBox x:Name="TextName" Caption="{DynamicResource WindowSaveMacroData_Label_MacroName}">
    </controls:EditBox>
    <Grid Name="savePathPanel" Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Label Content="{DynamicResource WindowSaveMacroData_Label_SavePath}" />
      <editors:ButtonEdit FrameworkElement.Name="btnSavePath" Grid.Column="1" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:BaseEdit.IsReadOnly="True" editors:BaseEdit.NullText="{DynamicResource WindowSaveMacroData_PleaseSelectSavePath}">
      </editors:ButtonEdit>
    </Grid>
    <Grid Row="3" Margin="0,12,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <ProgressBar Grid.Column="0" Height="24" Margin="0,0,10,0" BorderThickness="1" Foreground="{DynamicResource TreeLoadingProgressForeground}" IsIndeterminate="True" Style="{StaticResource ProgressVs}" BorderBrush="{x:Null}" Visibility="{Binding IsLoading, Converter={StaticResource ConvertBoolenToVisibility}}" />
      </Grid>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Name="BtnSave" Width="70" Margin="0,0,8,0" Content="{DynamicResource common_Save}">
        </Button>
        <Button Name="BtnCancel" Width="70" Margin="0,0,0,0" Content="{DynamicResource common_Cancel}">
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</macro:WIndowSaveMacroData>
