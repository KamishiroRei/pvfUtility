<?xml version="1.0" encoding="utf-8"?>
<searchpvf:WindowAddNewSearchResult xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" Window.Title="{DynamicResource WindowAddNewSearchResult_Title}" FrameworkElement.Width="300" FrameworkElement.Height="400" Window.SizeToContent="Height" xmlns:searchpvf="clr-namespace:PvfCode.Views.SearchPvf;assembly=pvfUtility">
