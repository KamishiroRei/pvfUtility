<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:local="clr-namespace:PvfCode.Views.SearchPvf.SearchName;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Padding="0">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <editors:ButtonEdit xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:ButtonEdit.AllowDefaultButton="False" BaseEdit.NullText="{DynamicResource ViewSearchNameControl_InputKeyword_NullText}" editors:ButtonEdit.NullValueButtonPlacement="EditBox" editors:ButtonEdit.ShowNullValueButtonOnFocusOnly="False" editors:TextEditBase.Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <editors:ButtonEdit.Buttons>
          <editors:ButtonInfo editors:CommonButtonInfo.ButtonKind="Toggle" editors:ButtonInfoBase.ClickMode="Press" FrameworkContentElement.ToolTip="{DynamicResource ViewSearchNameControl_CheckBox_FullWord}" editors:CommonButtonInfo.IsChecked="{Binding WholeWordMatch, Mode=TwoWay}">
            <editors:ButtonInfo.Content>
              <Image Width="16" Height="16" Source="{DynamicResource WholeWordMatch_16x}" Stretch="Fill" />
            </editors:ButtonInfo.Content>
          </editors:ButtonInfo>
          <editors:ButtonInfo editors:ButtonInfo.Content="{DynamicResource ViewSearchNameControl_Button_Search}" FrameworkContentElement.Cursor="Hand" editors:ButtonInfo.GlyphKind="Search" FrameworkContentElement.ToolTip="{DynamicResource ViewSearchNameControl_ToolTip}" editors:CommandButtonInfo.Command="{Binding OnSearchCommand}" />
        </editors:ButtonEdit.Buttons>
        <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
          <ui:KeyToCommand xmlns:ui="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" ui:KeyToCommand.KeyGesture="Enter" ui:EventToCommandBase.Command="{Binding OnSearchCommand}" />
        </interactivity:Interaction.Behaviors>
      </editors:ButtonEdit>
      <GridControl Grid.Row="1" FrameworkElement.Margin="0,1,0,0" xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" grid:DataControlBase.SelectionMode="Row" grid:DataControlBase.CurrentItem="{Binding SelectedItem}" grid:DataControlBase.ItemsSource="{Binding Items.CollectionView}" grid:DataControlBase.SelectedItem="{Binding SelectedItem2, Mode=OneWay}" grid:DataControlBase.SelectedItems="{Binding SelectedItems, Mode=TwoWay}" xmlns="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
        <grid1:GridControl.Columns xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
          <grid1:GridColumn grid:BaseColumn.Width="*" grid:ColumnBase.FieldName="ItemName" grid:BaseColumn.Header="{DynamicResource ViewSearchNameControl_ColumnHeader_Name}" grid:BaseColumn.HorizontalHeaderContentAlignment="Center" grid:ColumnBase.ShowAllTableValuesInCheckedFilterPopup="False" grid:ColumnBase.ShowAllTableValuesInFilterPopup="False" xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
            <grid:ColumnBase.CellTemplate>
              <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <StackPanel Orientation="Horizontal">
                  <Image Width="18" Height="18" Margin="0,0,0,0" Source="{Binding Row.ItemImage, Mode=OneWay}" />
                  <TextBlock Margin="3,0,0,0" VerticalAlignment="Center" Text="{Binding Row.ItemName}" />
                </StackPanel>
              </DataTemplate>
            </grid:ColumnBase.CellTemplate>
          </grid1:GridColumn>
          <grid1:GridColumn grid:BaseColumn.Width="130" grid:ColumnBase.AllowEditing="True" grid:ColumnBase.FieldName="ItemCode" grid:BaseColumn.Header="{DynamicResource ViewSearchNameControl_ColumnHeader_Code}" grid:BaseColumn.HorizontalHeaderContentAlignment="Center">
            <grid:ColumnBase.EditSettings>
              <settings:TextEditSettings xmlns:settings="clr-namespace:DevExpress.Xpf.Editors.Settings;assembly=DevExpress.Xpf.Core.v24.1" settings:BaseEditSettings.HorizontalContentAlignment="Center" />
            </grid:ColumnBase.EditSettings>
          </grid1:GridColumn>
        </grid1:GridControl.Columns>
        <GridControl.View>
          <grid1:TableView xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1" grid1:TableView.AllowBandMoving="False" grid1:TableView.AllowBandMultiRow="False" grid1:TableView.AllowBandResizing="False" grid1:TableView.AllowBestFit="False" grid1:TableView.AllowCascadeUpdate="False" grid:DataViewBase.AllowColumnFiltering="False" grid:DataViewBase.AllowColumnMoving="False" grid:DataViewBase.AllowEditing="True" grid1:TableView.AllowHorizontalScrollingVirtualization="True" grid:DataViewBase.EnableSelectedRowAppearance="True" grid1:TableView.HorizontalScrollbarVisibility="Auto" grid:DataViewBase.NavigationStyle="Row" grid1:TableView.ScrollBarAnnotationMode="Selected,FocusedRow,Custom " grid:DataViewBase.ScrollingMode="Smart" grid1:TableView.ShowAutoFilterRow="False" grid1:TableView.ShowBandsInCustomizationForm="False" grid1:TableView.ShowBandsPanel="False" grid:DataViewBase.ShowColumnHeaders="True" grid1:TableView.ShowDataNavigator="False" grid:DataViewBase.ShowEmptyText="False" grid:DataViewBase.ShowFilterPanelMode="Never" grid1:GridViewBase.ShowGroupPanel="False" grid1:TableView.ShowHorizontalLines="True" grid1:TableView.ShowIndicator="True" grid:DataViewBase.ShowSearchPanelMode="Default" grid:DataViewBase.ShowSelectionRectangle="True" grid1:TableView.ShowVerticalLines="True" grid1:TableView.UseEvenRowBackground="False" grid1:TableView.VerticalScrollbarVisibility="Auto" grid1:TableView.RowDoubleClickCommand="{Binding RowDoubleClickCommand}">
            <bars:BarManager.DXContextMenu xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
              <bars:PopupMenu>
                <bars:PopupMenu.Items xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
                  <bars:BarButtonItem BarItem.Content="{DynamicResource ViewSearchNameControl_ContextMenu_CopySelectedName}" BarItem.Glyph="{DynamicResource ItemName}" xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:BarItem.KeyGesture="Ctrl+R" bars:BarItem.Command="{Binding OnCopySelectedItemNameCommand}" />
                  <bars:BarButtonItem bars:BarItem.Content="{DynamicResource ViewSearchNameControl_ContextMenu_CopySelectedCode}" bars:BarItem.Glyph="{DynamicResource CodeIcon}" bars:BarItem.KeyGesture="Ctrl+E" bars:BarItem.Command="{Binding OnCopySelectedItemCodeCommand}" />
                  <bars:BarItemSeparator xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" />
                  <bars:BarButtonItem bars:BarItem.Content="{DynamicResource ViewSearchNameControl_ContextMenu_RemoveSelected}" bars:BarItem.Glyph="{DynamicResource Action_Delete}" bars:BarItem.KeyGesture="Delete" bars:BarItem.Command="{Binding OnDeleteSelectedCommand}" />
                </bars:PopupMenu.Items>
              </bars:PopupMenu>
            </bars:BarManager.DXContextMenu>
          </grid1:TableView>
        </GridControl.View>
      </GridControl>
    </Grid>
    <bars:ToolBarControl Grid.Row="2" xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:ToolBarControlBase.AllowCustomizationMenu="False" bars:ToolBarControl.AllowQuickCustomization="False">
      <bars:BarStaticItem>
        <bars:BarItem.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Count：" />
              <TextBlock Text="{Binding Path=DataContext.Count, Mode=OneWay, RelativeSource={RelativeSource AncestorType=dxb:ToolBarControl}}" />
            </StackPanel>
          </DataTemplate>
        </bars:BarItem.ContentTemplate>
      </bars:BarStaticItem>
    </bars:ToolBarControl>
  </Grid>
</UserControl>