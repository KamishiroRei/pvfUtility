    <Grid Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <ContentControl Name="contentPanel" Margin="10,0,10,0" ContentTemplate="{Binding TreeSelectedItem.Value.Data}">
      </ContentControl>
      <Grid Row="1" Margin="0,10,0,0" Visibility="{Binding ShowSaveButton, Converter={StaticResource ConvertBoolenToVisibility}}">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Width="90" Height="28" Margin="0,8,5,8" Content="{DynamicResource common_Save}" Cursor="Hand">
          </Button>
          <Button Width="90" Height="28" Margin="0,8,5,8" Content="{DynamicResource common_Cancel}" Cursor="Hand">
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</views:WindowPublicSetting>