<?xml version="1.0" encoding="utf-8"?>
<userviews:WindowEditUserInfo xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Assists="clr-namespace:PvfCode.Controls.AvatarControl" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:controls="clr-namespace:PvfCode.Controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:services="clr-namespace:PvfCode;assembly=PvfCode.Services" Window.Title="{DynamicResource WindowEditUserInfo_Title}" FrameworkElement.Width="400" FrameworkElement.Height="400" Window.ResizeMode="CanResizeWithGrip" Window.SizeToContent="Height" xmlns:userviews="clr-namespace:PvfCode.Views.UserViews" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border BorderBrush="#FF808080" BorderThickness="0.2">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <Assists:AvatarControlEx Width="100" Height="100" ImageSource="{Binding AvatarImageSource}" />
          <editors:HyperlinkEdit Grid.Row="1" FrameworkElement.Margin="0,0,0,0" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:HyperlinkEdit.AllowAutoNavigate="True" editors:HyperlinkEdit.CommandParameter="Register" BaseEdit.EditValue="{DynamicResource WindowEditUserInfo_Button_ChangeAvatar}" editors:HyperlinkEdit.Command="{Binding ChangedAvatarImageSourceCommand}" />
        </Grid>
      </Border>
      <Grid Column="1" Margin="10,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <controls:EditBox Caption="{DynamicResource WindowEditUserInfo_Label_NickName}" Value="{Binding UserInfo.NickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <controls:EditBox Grid.Row="1" Margin="0,10,0,0" Caption="{DynamicResource WindowEditUserInfo_Label_PhoneNumber}" NullText="{DynamicResource WindowEditUserInfo_TextBox_PhoneNumber_Placeholder}" IsEnabled="{Binding AllowEditPhone, Mode=OneWay}" Value="{Binding UserInfo.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Label Grid.Row="2" Content="{DynamicResource WindowEditUserInfo_TextBox_PhoneNumber_ToolTip}" Foreground="#FFFF0000" Visibility="{Binding AllowEditPhone, Mode=OneWay, Converter={StaticResource ConvertBoolenToVisibility}}" />
      </Grid>
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Width="60" Margin="0,10,10,5" Content="{DynamicResource common_Save}" Cursor="Hand" Command="{Binding SaveCommand}" />
      <Button Width="60" Margin="0,10,5,5" Content="{DynamicResource common_Close}" Cursor="Hand">
        <!--Unknown connection ID: 1-->
      </Button>
    </StackPanel>
  </Grid>
</userviews:WindowEditUserInfo>