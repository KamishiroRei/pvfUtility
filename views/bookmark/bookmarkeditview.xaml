<?xml version="1.0" encoding="utf-8"?>
<bookmark:BookMarkEditView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:bookmark="clr-namespace:PvfCode.Views.BookMark;assembly=pvfUtility" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:i1="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:pvfcode="clr-namespace:PvfCode;assembly=PvfCode.Services" xmlns:texteditlib="clr-namespace:TextEditLib;assembly=TextEditLib" xmlns:texteditorfolder="clr-namespace:PvfCode.Controls.TextEditorFolder;assembly=pvfUtility" FrameworkElement.Name="win" FrameworkElement.Width="600" FrameworkElement.Height="600" Control.Padding="0" Window.ResizeMode="CanResizeWithGrip" Window.Title="{Binding Title}" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
