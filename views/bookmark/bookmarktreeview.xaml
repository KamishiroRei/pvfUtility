<?xml version="1.0" encoding="utf-8"?>
<local:BookMarkTreeView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:bookmark="clr-namespace:PvfCode.Converts.BookMark;assembly=pvfUtility" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:local="clr-namespace:PvfCode.Views.BookMark;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mvvmservices="clr-namespace:PvfCode.MVVMServices;assembly=pvfUtility" xmlns:root="clr-namespace:PvfCode;assembly=pvfUtility" xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1" grid:TreeListControl.Name="treeList" Control.BorderThickness="0" xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" grid1:DataControlBase.SelectionMode="Row" Control.BorderBrush="{x:Null}" grid1:DataControlBase.ItemsSource="{Binding Trees, Mode=OneWay}" grid1:DataControlBase.SelectedItems="{Binding SelectedNodesBindBase, Mode=TwoWay}">
  <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
    <mvvmservices:TreeListService />
  </interactivity:Interaction.Behaviors>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <bookmark:ConverterBookMarkRowForeBrush x:Key="ConverterBookMarkRowForeBrush" />
      <DataTemplate x:Key="BookmarkRowTemplate">
        <StackPanel Name="stackPanel" Orientation="Horizontal">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <TextBlock Text="{Binding Row.Key, Mode=OneWay}" />
          <TextBlock Padding="20,0,0,0" Foreground="#ababab" Text="{Binding Row.Value.FilePath, Mode=OneWay}" Visibility="{Binding Row.Value.IsFile, Mode=OneWay, Converter={StaticResource ConvertBoolenToVisibility}}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <grid:TreeListControl.Columns>
    <grid:TreeListColumn grid1:BaseColumn.Name="columnKey" grid1:BaseColumn.Width="auto" ColumnBase.CellDisplayTemplate="{StaticResource BookmarkRowTemplate}" grid1:ColumnBase.FieldName="Key">
    </grid:TreeListColumn>
    <grid:TreeListColumn grid1:ColumnBase.AllowSorting="True" grid1:ColumnBase.AllowedSortOrders="Ascending" grid1:ColumnBase.FieldName="Value.Sort" grid1:ColumnBase.SortIndex="1" grid1:ColumnBase.SortMode="Default" grid1:BaseColumn.Visible="False" />
  </grid:TreeListControl.Columns>
  <grid:TreeListControl.View>
    <grid:TreeListView grid:TreeListView.Name="treeListView" FrameworkElement.Width="auto" grid:TreeListView.AllowAdvancedHorizontalNavigation="False" grid:TreeListView.AllowAdvancedVerticalNavigation="False" grid:TreeListView.AllowBandMoving="False" grid:TreeListView.AllowBandMultiRow="False" grid:TreeListView.AllowBandResizing="False" grid:TreeListView.AllowBestFit="False" grid:TreeListView.AllowCascadeUpdate="False" grid:TreeListView.AllowChildNodeSourceUpdates="False" grid1:DataViewBase.AllowColumnFiltering="False" grid1:DataViewBase.AllowEditing="False" grid:TreeListView.AllowHorizontalScrollingVirtualization="True" grid:TreeListView.AllowTreeIndentScrolling="False" grid:TreeListView.AutoExpandAllNodes="False" grid:TreeListView.AutoWidth="False" grid:TreeListView.CompactPanelShowMode="CompactMode" grid:TreeListView.FetchSublevelChildrenOnExpand="True" grid:TreeListView.HorizontalScrollbarVisibility="Auto" grid1:DataViewBase.IsDeferredScrolling="False" grid1:DataViewBase.NavigationStyle="Row" grid:TreeListView.NodeImageSelector="{StaticResource BookMarkTreeNodeImageSelector}" grid1:DataViewBase.RowAnimationKind="None" grid1:DataViewBase.ScrollingMode="Smart" grid:TreeListView.ShowCheckboxes="False" grid1:DataViewBase.ShowColumnHeaders="False" grid:TreeListView.ShowExpandButtons="True" grid:TreeListView.ShowHorizontalLines="False" grid:TreeListView.ShowIndicator="False" grid:TreeListView.ShowNodeImages="True" grid1:DataViewBase.ShowSelectionRectangle="True" grid:TreeListView.ShowVerticalLines="False" grid:TreeListView.TreeColumnFieldName="Key" grid:TreeListView.TreeDerivationMode="ChildNodesSelector" grid:TreeListView.UseEvenRowBackground="False" grid:TreeListView.VerticalScrollbarVisibility="Auto" grid:TreeListView.ChildNodesSelector="{Binding ChildNodesSelector}" grid1:DataViewBase.FocusedRow="{Binding SelectedNodeBindgBase, Mode=TwoWay}" grid:TreeListView.RowDoubleClickCommand="{Binding NodeDoubleClickCommand}" grid:TreeListView.ScrollBarAnnotationMode="{x:Null}">
      <grid:TreeListView.RowStyle>
        <Style TargetType="{x:Type grid:RowControl}">
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding Row.Value.CutStatus}">
              <Setter Property="UIElement.Opacity" Value="0.5" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </grid:TreeListView.RowStyle>
      <bars:BarManager.DXContextMenu xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
        <bars:PopupMenu UIElement.IsEnabled="{Binding IsPreview, Mode=OneWay, Converter={StaticResource ConverterBoolenToFalse}}">
          <bars:PopupMenu.Items xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
            <bars:BarButtonItem xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:BarItem.CommandParameter="false" bars:BarItem.Content="{DynamicResource BookMarkEditView_NewFolderButton}" bars:BarItem.Command="{Binding OnAddBookMarkCommand}" bars:BarItem.Glyph="{Binding Source={x:Static root:Res.Instance}, Path=TreeFiles.FolderClosed}" />
            <bars:BarButtonItem bars:BarItem.CommandParameter="true  " bars:BarItem.Content="{DynamicResource BookMarkEditView_NewBookMarkButton}" bars:BarItem.Command="{Binding OnAddBookMarkCommand}" bars:BarItem.Glyph="{Binding Source={x:Static root:Res.Instance}, Path=TreeFiles.Script_16x}" />
            <bars:BarItemSeparator xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource BookMarkEditView_ExpandAllBookMark}">
            </bars:BarButtonItem>
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource BookMarkEditView_CollapseAllBookMark}">
            </bars:BarButtonItem>
            <bars:BarItemSeparator />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource BookMarkEditView_MoveUp}" bars:BarItem.Glyph="{DynamicResource GoToUp}" bars:BarItem.Command="{Binding OnUpCommand}" bars:BarItem.KeyGesture="{Binding Source={x:Static root:KeyGestureStaticValue.Instance}, Path=AltAndUp}" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource BookMarkEditView_MoveDown}" bars:BarItem.Glyph="{DynamicResource GoToDown}" bars:BarItem.Command="{Binding OnDownCommand}" bars:BarItem.KeyGesture="{Binding Source={x:Static root:KeyGestureStaticValue.Instance}, Path=AltAndDown}" />
            <bars:BarItemSeparator />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource FileExplorer_RightClickMenu_Cut}" bars:BarItem.Glyph="{DynamicResource CutIcon}" bars:BarItem.KeyGesture="Ctrl+X" bars:BarItem.Command="{Binding OnCutCommand}" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource FileExplorer_RightClickMenu_Paste}" bars:BarItem.Glyph="{DynamicResource PasteIcon}" bars:BarItem.KeyGesture="Ctrl+V" bars:BarItem.Command="{Binding OnPasteCommand}" ContentElement.IsEnabled="{Binding PasteIsEnabled, Mode=OneWay}" />
            <bars:BarItemSeparator />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource FileExplorer_RightClickMenu_Delete}" bars:BarItem.Glyph="{DynamicResource Action_Delete}" bars:BarItem.KeyGesture="Delete" bars:BarItem.Command="{Binding OnDeleteSelectedNodesCommand}" />
            <bars:BarButtonItem bars:BarItem.Content="{DynamicResource BookMarkEditView_Edit}" bars:BarItem.Glyph="{DynamicResource EditComment}" bars:BarItem.KeyGesture="f2" bars:BarItem.Command="{Binding OnEditBookMarkCommand}" />
          </bars:PopupMenu.Items>
        </bars:PopupMenu>
      </bars:BarManager.DXContextMenu>
    </grid:TreeListView>
  </grid:TreeListControl.View>
</local:BookMarkTreeView>