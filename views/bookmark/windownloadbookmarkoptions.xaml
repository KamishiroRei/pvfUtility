<?xml version="1.0" encoding="utf-8"?>
<bookmark:WinDownLoadBookMarkOptions xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" Window.Title="{DynamicResource EditBookmarkView_DownloadOptions_WinTitle}" FrameworkElement.Width="400" FrameworkElement.Height="800" Control.Padding="10" Window.ResizeMode="NoResize" Window.SizeToContent="Height" Window.WindowStyle="ToolWindow" xmlns:bookmark="clr-namespace:PvfCode.Views.BookMark;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <Grid>
    <Grid.RowDefinitions>
