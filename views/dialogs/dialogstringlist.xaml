<?xml version="1.0" encoding="utf-8"?>
<dialogs:DialogStringList xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" FrameworkElement.MinWidth="300" Control.Padding="15" Window.ResizeMode="NoResize" Window.SizeToContent="WidthAndHeight" Window.WindowStyle="SingleBorderWindow" xmlns:dialogs="clr-namespace:PvfCode.Views.Dialogs;assembly=pvfUtility" Window.Title="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=AppName}" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="60" Height="60" Source="{DynamicResource Question_16x}" />
      <TextBlock Grid.Column="1" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" Text="{Binding Message}" />
    </Grid>
    <ListBox Grid.Row="1" Margin="0,20,0,20" HorizontalContentAlignment="Center" Background="#00FFFFFF" BorderThickness="0" ItemsSource="{Binding StringList}" />
    <StackPanel Grid.Row="2" Margin="0,8,0,5" HorizontalAlignment="Center" Orientation="Horizontal">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="5,0,5,0" />
            <Setter Property="FrameworkElement.Cursor" Value="Hand" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Button Name="BtnYes" Width="70" Content="{Binding YseTitle}">
      </Button>
      <Button Name="BtnNo" Width="70" Content="{Binding NoTitle}">
      </Button>
      <Button Name="BtnCancel" Width="70" Content="{Binding CancelTitle}">
      </Button>
    </StackPanel>
  </Grid>
</dialogs:DialogStringList>