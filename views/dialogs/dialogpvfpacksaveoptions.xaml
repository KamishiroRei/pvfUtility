<?xml version="1.0" encoding="utf-8"?>
<dialogs:DialogPvfPackSaveOptions xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" Window.Title="封装选项" FrameworkElement.Width="400" Window.ResizeMode="NoResize" Window.SizeToContent="Height" xmlns:dialogs="clr-namespace:PvfCode.Views.Dialogs;assembly=pvfUtility">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Margin="0,0,0,0" Background="{DynamicResource PvfReleasePanelBackbrush}" CornerRadius="5">
      <StackPanel Margin="10" Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
          <CheckBox Content="裁剪stringTable.bin文件：未被引用的字符串" IsChecked="{Binding Path=PvfConfig.SavePvfPackTrimmableStringBinFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static appsetting:AppSetting.Instance}}" />
          <Label Margin="5,0,0,0" Foreground="#FF808080">建议裁剪</Label>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <CheckBox Content="裁剪kor.str文件：未被引用的字符串" IsChecked="{Binding Path=PvfConfig.SavePvfPackTrimmableStringViewFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static appsetting:AppSetting.Instance}}" />
          <Label Margin="5,0,0,0" Foreground="#FF808080">建议裁剪</Label>
        </StackPanel>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <CheckBox Margin="0,0,10,0" Content="不再提示" IsChecked="{Binding Path=PvfConfig.NotPromptSavePvfPackOptionsDialog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static appsetting:AppSetting.Instance}}" />
      <Button Width="70" Cursor="Hand">确定</Button>
    </StackPanel>
  </Grid>
</dialogs:DialogPvfPackSaveOptions>