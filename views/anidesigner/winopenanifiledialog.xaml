<?xml version="1.0" encoding="utf-8"?>
<anidesigner:WinOpenAniFileDialog xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:anidesigner="clr-namespace:PvfCode.Views.AniDesigner;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui" FrameworkElement.Name="win" Window.Title="打开ani" FrameworkElement.Width="600" Control.Padding="10" Window.ResizeMode="NoResize" Window.SizeToContent="Height">
  <FrameworkElement.DataContext>
    <anidesigner:WinOpenAniFileDialogViewModel />
  </FrameworkElement.DataContext>
  <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
    <core:DXMessageBoxService xmlns:core="clr-namespace:DevExpress.Xpf.Core;assembly=DevExpress.Xpf.Core.v24.1" />
  </interactivity:Interaction.Behaviors>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="auto" />
    </Grid.ColumnDefinitions>
    <Label>ani文件路径：</Label>
    <TextBox Grid.Column="1" Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <Interaction.Behaviors xmlns="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
        <ui:FocusBehavior xmlns:ui="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" />
      </Interaction.Behaviors>
    </TextBox>
    <Button Grid.Column="2" Width="70" Height="24" Margin="5,0,0,0" Content="确定" Command="{Binding OnYesCommand}" CommandParameter="{Binding ElementName=win}" />
  </Grid>
</anidesigner:WinOpenAniFileDialog>