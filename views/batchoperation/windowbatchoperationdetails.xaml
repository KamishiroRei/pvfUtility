              <RowDefinition Height="auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <BarContainerControl Grid.Row="0" xmlns="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
              <ToolBarControl p15:ToolBarControlBase.AllowCustomizationMenu="False" p15:ToolBarControl.AllowQuickCustomization="False" p15:ToolBarControl.ShowDragWidget="True" xmlns:p15="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
                <p15:BarButtonItem p15:BarItem.CommandParameter="true" p15:BarItem.Content="{DynamicResource WindowBatchOperationDetails_ExportPath}" p15:BarItem.Command="{Binding ImportFilesForTxtCommand}" />
              </ToolBarControl>
            </BarContainerControl>
            <controls:PvfTreeViewGroup Grid.Row="1" DataContext="{Binding ErrorTreeViewModel}" />
          </Grid>
        </docking:LayoutPanel>
      </docking:LayoutGroup>
    </docking:DockLayoutManager>
  </Grid>
</batchoperation:WindowBatchOperationDetails>