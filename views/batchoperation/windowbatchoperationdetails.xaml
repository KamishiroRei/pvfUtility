              <bars:ToolBarControl xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:ToolBarControlBase.AllowCustomizationMenu="False" bars:ToolBarControl.AllowQuickCustomization="False" bars:ToolBarControl.ShowDragWidget="True">
                <bars:BarButtonItem bars:BarItem.CommandParameter="false" bars:BarItem.Content="{DynamicResource WindowBatchOperationDetails_ExportPath}" bars:BarItem.Command="{Binding ImportFilesForTxtCommand}" />
              </bars:ToolBarControl>
            </bars:BarContainerControl>
            <controls:PvfTreeViewGroup Grid.Row="1" DataContext="{Binding SuccessTreeViewModel}" />
          </Grid>
        </docking:LayoutPanel>
        <docking:LayoutPanel docking:BaseLayoutItem.AllowDock="False" docking:BaseLayoutItem.AllowFloat="False" docking:BaseLayoutItem.Caption="{DynamicResource WindowBatchOperationDetails_FailedFiles_Caption}" docking:BaseLayoutItem.ItemWidth="*">
          <Grid>
