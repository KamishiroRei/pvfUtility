<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PvfCode.Views.ChatGPT.ChatGPTMessDocument" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:local="clr-namespace:PvfCode.Views.ChatGPT" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Padding="20,20,20,20">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>
      <editors:ButtonEdit FrameworkElement.Height="auto" FrameworkElement.MinHeight="40" FrameworkElement.MaxHeight="200" Control.VerticalContentAlignment="Center" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:TextEditBase.AcceptsReturn="True" editors:ButtonEdit.AllowDefaultButton="False" editors:BaseEdit.NullText="输入你想问的问题" editors:TextEditBase.TextWrapping="Wrap" editors:TextEditBase.VerticalScrollBarVisibility="Auto" editors:TextEditBase.Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <editors:ButtonEdit.Buttons>
          <editors:ButtonInfo FrameworkContentElement.Cursor="Hand" FrameworkContentElement.ToolTip="发送" ToolTipService.InitialShowDelay="50" editors:CommandButtonInfo.Command="{Binding OnSendCommand}">
            <editors:ButtonInfo.Content>
              <Image Width="16" Height="16" Source="{DynamicResource chatGPTSend}" Stretch="Fill" />
            </editors:ButtonInfo.Content>
          </editors:ButtonInfo>
        </editors:ButtonEdit.Buttons>
      </editors:ButtonEdit>
    </Grid>
  </Grid>
</UserControl>