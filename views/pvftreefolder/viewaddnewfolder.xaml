<?xml version="1.0" encoding="utf-8"?>
<pvftreefolder:ViewAddNewFolder xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui" FrameworkElement.Name="win" Window.Title="{DynamicResource ViewAddNewFolder_Title}" FrameworkElement.MinWidth="400" Control.Padding="10" Window.ResizeMode="NoResize" Window.SizeToContent="WidthAndHeight" xmlns:pvftreefolder="clr-namespace:PvfCode.Views.PvfTreeFolder;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
    <windowsui:WinUIMessageBoxService xmlns:windowsui="clr-namespace:DevExpress.Xpf.WindowsUI;assembly=DevExpress.Xpf.Controls.v24.1" />
  </interactivity:Interaction.Behaviors>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TextBlock VerticalAlignment="Center" Foreground="#FFFF0000" Text="{Binding ParentFolderName, Mode=OneWay}" />
    <editors:TextEdit FrameworkElement.Name="textInput" Grid.Column="1" FrameworkElement.MinWidth="200" FrameworkElement.Margin="5,0,0,0" BaseEdit.NullText="{DynamicResource ViewAddNewFolder_FolderName_NullText}" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:TextEditBase.Text="{Binding FolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
    </editors:TextEdit>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Name="buttonOk" Width="70" Margin="0,0,5,0" Content="{DynamicResource common_OK}" Command="{Binding OnOKCommand}" CommandParameter="{Binding ElementName=win}" IsEnabled="{Binding ElementName=textInput, Path=Text, Mode=OneWay, Converter={StaticResource ConverterEditValueToIsEnabled}}">
      </Button>
      <Button Width="70" Content="{DynamicResource common_Cancel}" Command="{Binding OnCancelCommand}" CommandParameter="{Binding ElementName=win}" />
    </StackPanel>
  </Grid>
</pvftreefolder:ViewAddNewFolder>