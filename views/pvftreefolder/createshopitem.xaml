<?xml version="1.0" encoding="utf-8"?>
<pvftreefolder:CreateShopItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:pvftreefolder="clr-namespace:PvfCode.Views.PvfTreeFolder;assembly=pvfUtility" FrameworkElement.Name="win" Window.Title="生成商城代码" FrameworkElement.MinWidth="300" Control.Padding="20" Window.SizeToContent="WidthAndHeight">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Label>类型：</Label>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
            <Setter Property="FrameworkElement.Cursor" Value="Hand" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <RadioButton Content="creature" IsChecked="{Binding Type, Converter={StaticResource ConvertEnumToBoolen}, ConverterParameter={x:Static pvftreefolder:ShopSectionType.creature}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <RadioButton Margin="10,0,0,0" Content="item" IsChecked="{Binding Type, Converter={StaticResource ConvertEnumToBoolen}, ConverterParameter={x:Static pvftreefolder:ShopSectionType.item}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <RadioButton Margin="10,0,0,0" Content="package" IsChecked="{Binding Type, Converter={StaticResource ConvertEnumToBoolen}, ConverterParameter={x:Static pvftreefolder:ShopSectionType.package}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <RadioButton Margin="10,0,0,0" Content="premium" IsChecked="{Binding Type, Converter={StaticResource ConvertEnumToBoolen}, ConverterParameter={x:Static pvftreefolder:ShopSectionType.premium}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <Label Grid.Row="1" Margin="0,10,0,0">销售价格：</Label>
    <TextBox Grid.Row=" 1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <Label Grid.Row="2" Margin="0,10,0,0" Visibility="{Binding ItemCountVisibility}">物品数量：</Label>
    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding ItemCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ItemCountVisibility}" />
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,0" HorizontalAlignment="Right">
      <Button Command="{Binding OnOkCommand}" CommandParameter="{Binding ElementName=win}">生成</Button>
    </StackPanel>
  </Grid>
</pvftreefolder:CreateShopItem>