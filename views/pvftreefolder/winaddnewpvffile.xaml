<?xml version="1.0" encoding="utf-8"?>
<pvftreefolder:WinAddNewPvfFile xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" Window.Title="{DynamicResource WinAddNewPvfFile_Title}" FrameworkElement.Width="490" FrameworkElement.Height="130" Control.Padding="10" Window.ResizeMode="NoResize" Window.SizeToContent="Height" Window.WindowStyle="ToolWindow" xmlns:pvftreefolder="clr-namespace:PvfCode.Views.PvfTreeFolder;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Label Content="{DynamicResource WinAddNewPvfFile_Label_CurrentFolder}" />
      <Label Name="labelRootPath" Foreground="#FFFF0000">
      </Label>
    </StackPanel>
    <Label Grid.Row="1" Margin="0,5,0,0" Content="{DynamicResource WinAddNewPvfFile_Label_InputNewFileName}" />
    <controls:EditBox x:Name="TextFileName" Grid.Row="2" Margin="0,10,0,0" Caption="{DynamicResource WinAddNewPvfFile_Label_FilePath}">
    </controls:EditBox>
    <StackPanel Grid.Row="3" Margin="0,10,0,8" HorizontalAlignment="Right" Orientation="Horizontal">
      <CheckBox Name="newFileRegLst" Margin="0,0,10,0" Content="{DynamicResource WinAddNewPvfFile_CheckBox_RegisterToLst}">
      </CheckBox>
      <Button Name="BtnSave" Width="70" Margin="0,0,10,0" Content="{DynamicResource common_OK}">
      </Button>
      <Button Name="BtnCancel" Width="70" Content="{DynamicResource common_Cancel}">
      </Button>
    </StackPanel>
  </Grid>
</pvftreefolder:WinAddNewPvfFile>