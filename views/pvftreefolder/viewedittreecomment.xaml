<?xml version="1.0" encoding="utf-8"?>
<pvftreefolder:ViewEditTreeComment xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:root="clr-namespace:PvfCode;assembly=pvfUtility" Window.Title="{DynamicResource ViewEditTreeComment_Title}" FrameworkElement.Width="400" FrameworkElement.Height="300" Control.Padding="10" xmlns:pvftreefolder="clr-namespace:PvfCode.Views.PvfTreeFolder;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <controls:EditBox Caption="{DynamicResource ViewEditTreeComment_Comment}" Value="{Binding TreeListComment.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <layoutcontrol:GroupBox Grid.Row="1" FrameworkElement.Margin="0,10,0,10" Control.Padding="0" HeaderedContentControlBase.Header="{DynamicResource ViewEditTreeComment_DetailComment}" xmlns:layoutcontrol="clr-namespace:DevExpress.Xpf.LayoutControl;assembly=DevExpress.Xpf.LayoutControl.v24.1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <editors:TextEdit FrameworkElement.Name="textWarp" Control.VerticalContentAlignment="Top" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:TextEditBase.AcceptsReturn="True" Control.BorderThickness="0" BaseEdit.NullText="{DynamicResource ViewEditTreeComment_DetailComment_NullText}" editors:TextEditBase.TextWrapping="Wrap" editors:TextEditBase.Text="{Binding TreeListComment.DetailedComment, UpdateSourceTrigger=PropertyChanged}">
        </editors:TextEdit>
      </ScrollViewer>
    </layoutcontrol:GroupBox>
    <Grid Row="2" Margin="0,0,0,10">
      <editors:HyperlinkEdit Grid.Column="1" FrameworkElement.Margin="0,0,0,0" FrameworkElement.VerticalAlignment="Center" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:HyperlinkEdit.AllowAutoNavigate="True" BaseEdit.EditValue="{DynamicResource EditorToolTipStyle_ItemCodeHover_ShareSetting}" editors:HyperlinkEdit.Command="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=BarsVm.OnOpenPublicSettingCommand}" editors:HyperlinkEdit.CommandParameter="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=LuanguageOptions.GoToStoreShareOption_FileExplorerComment}" />
    </Grid>
    <Button Grid.Row="3" Height="24" Content="{DynamicResource common_Save}" Cursor="Hand" Command="{Binding OnSaveCommand}" />
  </Grid>
</pvftreefolder:ViewEditTreeComment>