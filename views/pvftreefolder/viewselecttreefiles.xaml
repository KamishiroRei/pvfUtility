<?xml version="1.0" encoding="utf-8"?>
<pvftreefolder:ViewSelectTreeFiles xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:controls="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui" xmlns:editors="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:root="clr-namespace:PvfCode;assembly=pvfUtility" Window.Title="{DynamicResource ViewSelectTreeFiles_Title}" FrameworkElement.Width="450" FrameworkElement.Height="500" Control.Padding="0" Window.Topmost="True" Window.WindowStartupLocation="CenterScreen" xmlns:pvftreefolder="clr-namespace:PvfCode.Views.PvfTreeFolder;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
    <windowsui:WinUIMessageBoxService xmlns:windowsui="clr-namespace:DevExpress.Xpf.WindowsUI;assembly=DevExpress.Xpf.Controls.v24.1" />
  </interactivity:Interaction.Behaviors>
  <Grid IsEnabled="{Binding IsLoading, Converter={StaticResource ConverterBoolenToFalse}, Mode=TwoWay}">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Grid Visibility="{Binding SearchPanelComboBoxVisibility, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Label Margin="5,0,0,0" Content="{DynamicResource ViewSelectTreeFiles_Label_SelectSearchResult}" />
      <editors1:ComboBoxEdit Grid.Column="1" Control.BorderThickness="1" xmlns:editors1="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors1:ButtonEdit.IsTextEditable="False" editors1:BaseEdit.ShowBorder="True" editors1:LookUpEditBase.ItemsSource="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=SearchResultViewModel.SearchReusltData.Keys}" editors1:LookUpEditBase.SelectedItem="{Binding SearchResultSelectedItem, Mode=TwoWay}" />
    </Grid>
    <controls:PvfTreeViewGroup Grid.Row="1" DataContext="{Binding TreeViewModel}" />
    <Grid Row="2">
      <StackPanel Margin="0,8,0,8" HorizontalAlignment="Right" Orientation="Horizontal">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
              <Setter Property="Margin" Value="0,0,10,0" />
              <Setter Property="Width" Value="70" />
              <Setter Property="Height" Value="24" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Button Content="{DynamicResource common_Save}" Command="{Binding OnYesCommand}" />
        <Button Content="{DynamicResource common_Cancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</pvftreefolder:ViewSelectTreeFiles>