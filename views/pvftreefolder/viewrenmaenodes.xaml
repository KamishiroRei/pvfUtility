howSelectionRectangle="False" grid:DataViewBase.ShowTargetInfoInDragDropHint="True" grid1:TreeListView.ShowVerticalLines="False" grid1:TreeListView.TreeColumnFieldName="Key" grid1:TreeListView.TreeDerivationMode="ChildNodesSelector" grid1:TreeListView.VerticalScrollbarVisibility="Auto" grid1:TreeListView.ChildNodesSelector="{Binding ChildNodesSelector}" grid1:TreeListView.RowDoubleClickCommand="{Binding NodeDoubleClickCommand}" grid1:TreeListView.ShowHorizontalLines="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.ShowHorizontalLines, Mode=OneWay}" grid1:TreeListView.UseEvenRowBackground="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=TreeSetting.UseEvenRowBackground, Mode=OneWay}">
