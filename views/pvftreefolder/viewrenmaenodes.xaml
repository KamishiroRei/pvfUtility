                <bars:BarButtonItem xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:BarItem.CommandParameter="false" bars:BarItem.Content="{DynamicResource ViewReNmaeNodes_ContextMenu_ExpandAll}" bars:BarItem.Command="{Binding ElementName=treeListView, Path=Commands.ExpandAllNodes}" />
                <bars:BarButtonItem bars:BarItem.CommandParameter="true" bars:BarItem.Content="{DynamicResource ViewReNmaeNodes_ContextMenu_CollapseAll}" bars:BarItem.Command="{Binding ElementName=treeListView, Path=Commands.CollapseAllNodes}" />
