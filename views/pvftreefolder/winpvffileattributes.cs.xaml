<?xml version="1.0" encoding="utf-8"?>
<pvftreefolder:WinPvfFileAttributes xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" Window.Title="{DynamicResource WinPvfFileAttributes_Title}" FrameworkElement.Width="400" FrameworkElement.Height="600" Control.Padding="20" Window.WindowStartupLocation="CenterScreen" xmlns:pvftreefolder="clr-namespace:PvfCode.Views.PvfTreeFolder;assembly=pvfUtility" Control.FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=FontSize}">
  <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
    <ui:EventToCommand xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1" interactivity:EventTriggerBase.Event="Loaded" xmlns:ui="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" ui:EventToCommandBase.Command="{Binding LoadedCommand}" />
  </interactivity:Interaction.Behaviors>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <Image Grid.Row="0" Width="45" Height="45" Source="{Binding Img, Mode=OneWay}" />
    <TextBox Grid.Column="1" Height="24" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding TreeFile.FileName, Mode=OneWay}" />
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Height="1" Margin="0,10,0,5" Background="#FF808080" />
    <Label Grid.Row="2" Content="{DynamicResource WinPvfFileAttributes_Label_Type}" />
    <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding FileType, Mode=OneWay}" />
    <Label Grid.Row="3" Content="{DynamicResource WinPvfFileAttributes_Label_FillePath}" />
    <TextBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding TreeFile.FullPath, Mode=OneWay}" />
    <Label Grid.Row="4" Content="{DynamicResource WinPvfFileAttributes_Label_Size}" />
    <TextBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding FileSize, Mode=OneWay}" />
    <Label Grid.Row="5" Content="{DynamicResource WinPvfFileAttributes_Label_Contains}" />
    <TextBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding FolderInfo, Mode=OneWay}" />
    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Height="1" Margin="0,10,0,5" Background="#FF808080" />
    <Label Grid.Row="7" Content="{DynamicResource WinPvfFileAttributes_Label_Comment}" />
    <TextBox Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding TreeFile.Comment, Mode=OneWay}" />
    <Label Grid.Row="8" Content="{DynamicResource WinPvfFileAttributes_Label_Name}" />
    <TextBox Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding TreeFile.ItemName, Mode=OneWay}" />
    <Label Grid.Row="9" Content="{DynamicResource WinPvfFileAttributes_Label_Code}" />
    <TextBox Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" IsReadOnly="True" Text="{Binding TreeFile.ItemCodeStr, Mode=OneWay}" />
  </Grid>
</pvftreefolder:WinPvfFileAttributes>