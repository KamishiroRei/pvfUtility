<?xml version="1.0" encoding="utf-8"?>
<local:WorlddropTool xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:TextEditLib="clr-namespace:TextEditLib;assembly=TextEditLib" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:local="clr-namespace:PvfCode.Views.Tools;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Window.Title="全局爆率管理器" FrameworkElement.Width="800" FrameworkElement.Height="450">
  <Grid>
    <TabControl Padding="10">
      <TabItem Header="批量删除">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <Grid>
            <editors:TextEdit Control.HorizontalContentAlignment="Left" Control.VerticalContentAlignment="Top" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:BaseEdit.NullText="使用\t分割的代码" editors:TextEditBase.TextWrapping="Wrap" editors:TextEditBase.Text="{Binding DeleteInputValue}" />
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,20,0,0" Orientation="Horizontal">
            <Label>等级条件：</Label>
            <TextBox Width="50" Text="{Binding DeleteLevelMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <Label Margin="5,0,5,0">一</Label>
            <TextBox Width="50" Text="{Binding DeleteLevelMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            <Label Margin="5,0,5,0">级</Label>
            <Button Command="{Binding OnDeleteCommand}">删除</Button>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</local:WorlddropTool>