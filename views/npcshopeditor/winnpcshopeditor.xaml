                                </Grid>
                              </Grid>
                            </Border>
                            <Border Grid.Row="1" BorderBrush="#46372f" BorderThickness="1,0,1,1" CornerRadius="0,0,3,3">
                              <Border Grid.Row="1" BorderBrush="#65552d" BorderThickness="2.5,0,2.5,2.5" CornerRadius="0,0,3,3">
                                <Grid>
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                  </Grid.RowDefinitions>
                                  <Border Width="280" Margin="0,5,0,0" BorderBrush="#FF000000" BorderThickness="0">
                                    <Image Height="60" Source="/images/pngs/npcshop/npcshopheader.png" Stretch="Fill" />
                                  </Border>
                                  <TabControl Grid.Row="1" Margin="15,10,15,64" ContentTemplate="{StaticResource NpcShopContentTemplate}" Style="{StaticResource NpcShopTabControlStyle}" ItemsSource="{Binding Pages.CollectionView}" SelectedItem="{Binding CurrentPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <FrameworkElement.Resources>
                                      <ResourceDictionary>
                                        <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
                                          <Setter Property="TabItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                          <Setter Property="Template">
                                            <Setter.Value>
                                              <ControlTemplate TargetType="{x:Type TabItem}">
                                                <Grid Width="67" Height="20">
                                                  <Image Name="img" Width="67" Height="20" />
                                                  <Grid>
                                                    <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="*" />
                                                      <ColumnDefinition Width="auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#c7b185" Text="{Binding Title}" />
                                                    <SimpleButton Grid.Column="1" FrameworkElement.Width="10" FrameworkElement.Height="10" FrameworkElement.Margin="0,0,3,0" FrameworkElement.HorizontalAlignment="Right" Control.Background="#00FFFFFF" Control.BorderThickness="0" p45:SimpleButton.Glyph="{DynamicResource Close}" FrameworkElement.ToolTip="删除当前页" ToolTipService.InitialShowDelay="50" ButtonBase.Command="{Binding Path=DataContext.OnDeletePageCommand, RelativeSource={RelativeSource AncestorType=Window}}" ButtonBase.CommandParameter="{Binding}" xmlns:p45="clr-namespace:DevExpress.Xpf.Core;assembly=DevExpress.Xpf.Core.v24.1" xmlns="clr-namespace:DevExpress.Xpf.Core;assembly=DevExpress.Xpf.Core.v24.1" />
