                  <ContentControl Grid.Row="1" FontFamily="{StaticResource IconFontFZKT}" Visibility="Visible" FontSize="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=PvfFilePreviewOptions.FontSize, Mode=OneWay}" IsEnabled="{Binding ShopIsOpen}">
                    <Grid Background="#FF808080">
                      <Grid Width="310" Height="453" Background="#171d28" Opacity="0.95">
                        <Border>
                          <Grid>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="auto" />
                              <RowDefinition />
