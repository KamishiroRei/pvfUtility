                  <controls:EditBox Caption="物品ID：" Value="{Binding CurrentPage.CurrentItem.ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <controls:EditBox Caption="物品名：" Value="{Binding CurrentPage.CurrentItem.ItemName, Mode=OneWay}" />
                </StackPanel>
              </docking:LayoutPanel>
            </docking:LayoutGroup>
          </docking:LayoutGroup>
        </docking:LayoutGroup>
      </docking:LayoutGroup>
    </docking:DockLayoutManager>
  </BarManager>
