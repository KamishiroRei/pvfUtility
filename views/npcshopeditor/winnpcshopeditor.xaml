            <docking:LayoutGroup docking:BaseLayoutItem.ItemWidth="*" docking:LayoutGroup.Orientation="Vertical" UIElement.IsEnabled="{Binding ShopIsOpen}">
              <docking:LayoutPanel docking:BaseLayoutItem.Padding="0" docking:BaseLayoutItem.Caption="商店属性" docking:BaseLayoutItem.ClosingBehavior="HideToClosedPanelsCollection" docking:BaseLayoutItem.ItemHeight="*">
                <StackPanel Margin="4,10,4,0" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
