                                      </ResourceDictionary>
                                    </FrameworkElement.Resources>
                                  </TabControl>
                                </Grid>
                              </Border>
                            </Border>
                          </Grid>
                        </Border>
                        <Image Width="39" Height="39" Margin="-5,-10,0,0" HorizontalAlignment="Left" VerticalAlignment="top" Source="/images/pngs/npcshop/48.png" Stretch="Fill" />
                      </Grid>
                    </Grid>
                  </ContentControl>
                </Grid>
              </docking:LayoutPanel>
              <docking:LayoutPanel docking:BaseLayoutItem.Caption="输出">
                <StackPanel Margin="10" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
