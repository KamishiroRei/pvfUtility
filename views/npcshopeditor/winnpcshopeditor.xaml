                <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <bars:BarContainerControl xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" UIElement.IsEnabled="{Binding ShopIsOpen}">
                    <bars:ToolBarControl xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:ToolBarControl.AllowCollapse="False" bars:ToolBarControlBase.AllowCustomizationMenu="False" bars:ToolBarControlBase.AllowHide="False" bars:ToolBarControl.AllowQuickCustomization="False" bars:ToolBarControlBase.AllowRemove="False" bars:ToolBarControlBase.BarItemHorizontalIndent="0" bars:ToolBarControl.ShowDragWidget="True" bars:ToolBarControl.UseWholeRow="True">
                      <bars:BarButtonItem bars:BarItem.BarItemDisplayMode="ContentAndGlyph" bars:BarItem.Content="添加页" bars:BarItem.Glyph="{DynamicResource AddLayoutItem}" bars:BarItem.KeyGesture="Ctrl+o" bars:BarItem.Command="{Binding OnAddPageCommand}" />
                      <bars:BarItemSeparator />
                      <bars:BarButtonItem bars:BarItem.BarItemDisplayMode="ContentAndGlyph" bars:BarItem.Content="向左移动页" bars:BarItem.Glyph="{DynamicResource BackwardsIcon}" bars:BarItem.Command="{Binding OnMoveLeftPageCommand}" />
                      <bars:BarButtonItem bars:BarItem.BarItemDisplayMode="ContentAndGlyph" bars:BarItem.Content="向右移动页" bars:BarItem.Glyph="{DynamicResource ForwardsIcon}" bars:BarItem.Command="{Binding OnMoveRightPageCommand}" />
                    </bars:ToolBarControl>
