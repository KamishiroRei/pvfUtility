<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:local="clr-namespace:PvfCode.Views.Preview.Controls;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:preview="clr-namespace:PvfCode.Views.Preview;assembly=pvfUtility">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type dxg:GridCard}" TargetType="{x:Type dxg:GridCard}">
        <Setter Property="Control.BorderBrush" Value="{x:Null}" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <ContentControl Name="card" Padding="0">
                <ContentControl Margin="0" Padding="0" ClipToBounds="False">
                  <Control.Template>
                    <DynamicResourceExtension ResourceKey="{dxgt:GridCardThemeKey ResourceKey=DataContentTemplate}" />
                  </Control.Template>
                  <dxg:GridCardContentPresenter dxg:GridCardContentPresenter.Name="presenter" FrameworkElement.Margin="2" UIElement.ClipToBounds="False">
                    <FrameworkElement.Style>
                      <DynamicResourceExtension ResourceKey="{dxgt:GridCardThemeKey ResourceKey=ContentPresenterStyle}" />
                    </FrameworkElement.Style>
                  </dxg:GridCardContentPresenter>
                </ContentControl>
              </ContentControl>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="contentTemplate">
        <Grid Margin="5">
          <Border Name="border" MaxWidth="30.2" MaxHeight="30.2" BorderBrush="#a77a41" BorderThickness="2.2" CornerRadius="4" Cursor="Hand">
            <Grid>
              <Image Stretch="Fill" Source="{Binding Row.ImageSource, Mode=OneWay}" />
              <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="微软雅黑" FontSize="9" FontWeight="Bold" Foreground="#FFEDECEB" Text="{Binding Row.ItemCount}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="4" Direction="330" Opacity="0.5" ShadowDepth="4" Color="Black" />
                </UIElement.Effect>
              </TextBlock>
            </Grid>
          </Border>
          <FlyoutControl p17:FlyoutControl.Name="flyoutControl" Control.Padding="0" Control.BorderThickness="0" FrameworkElement.FlowDirection="LeftToRight" p18:FlyoutBase.StaysOpen="True" Control.Background="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=PvfFilePreviewOptions.CurrentColorConfing.PvfFilePreviewBackBrush, Converter={StaticResource TreeColorConverterPreview}}" Control.BorderBrush="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=PvfFilePreviewOptions.CurrentColorConfing.PvfFilePreviewBorderBrush, Converter={StaticResource TreeColorConverterPreview}}" p18:FlyoutBase.PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" xmlns:p18="clr-namespace:DevExpress.Xpf.Editors.Flyout.Native;assembly=DevExpress.Xpf.Core.v24.1" xmlns:p17="clr-namespace:DevExpress.Xpf.Editors.Flyout;assembly=DevExpress.Xpf.Core.v24.1" xmlns="clr-namespace:DevExpress.Xpf.Editors.Flyout;assembly=DevExpress.Xpf.Core.v24.1">
            <FrameworkElement.Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <Style TargetType="{x:Type FlyoutControl}">
                <Setter Property="FlyoutBase.Settings">
                  <Setter.Value>
                    <p17:FlyoutSettings p17:FlyoutSettings.Placement="Bottom" p17:FlyoutSettings.ShowIndicator="True" />
                  </Setter.Value>
                </Setter>
                <Setter Property="FlyoutBase.IsOpen" Value="False" />
              </Style>
            </FrameworkElement.Style>
            <Border BorderThickness="1" Focusable="False" BorderBrush="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=PvfFilePreviewOptions.CurrentColorConfing.PvfFilePreviewBorderBrush, Converter={StaticResource TreeColorConverterPreview}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
              <preview:PreviewPvfItemControl x:Name="previewControl" ContentEx="{Binding Row.PreviewBase}" />
            </Border>
          </FlyoutControl>
        </Grid>
        <ControlTemplate.Triggers>
          <EventTrigger RoutedEvent="Control.MouseEnter">
            <BeginStoryboard>
              <Storyboard>
                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="flyoutControl" Storyboard.TargetProperty="IsOpen">
                  <DiscreteBooleanKeyFrame KeyTime="0:0:0.1" Value="True" />
                </BooleanAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="Control.MouseLeave">
            <BeginStoryboard>
              <Storyboard>
                <BooleanAnimationUsingKeyFrames Storyboard.TargetName="flyoutControl" Storyboard.TargetProperty="IsOpen">
                  <DiscreteBooleanKeyFrame KeyTime="0:0:0.05" Value="False" />
                </BooleanAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="border" Property="Border.BorderBrush" Value="#FFE89425" />
            <Setter Property="Control.BorderThickness" Value="2" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <DataTemplate x:Key="cardTemplate">
        <ContentControl Template="{StaticResource contentTemplate}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <dxg:GridControl FrameworkElement.Name="Grid" FrameworkElement.Height="auto" dxg:GridControl.AutoExpandAllGroups="True" dxg:GridControl.Background="#00FFFFFF" xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" grid:DataControlBase.SelectionMode="Row" grid:DataControlBase.ShowBorder="False" grid:DataControlBase.CurrentItem="{Binding CurrentItem}" grid:DataControlBase.ItemsSource="{Binding Path=Items.CollectionView, RelativeSource={RelativeSource AncestorType=local:PvfItemAvatarListBoxGroupControl, Mode=FindAncestor}}">
      <dxg:GridControl.Columns>
        <dxg:GridColumn grid:ColumnBase.FieldName="Icon" />
        <dxg:GridColumn dxg:GridColumn.Name="columnName" grid:ColumnBase.FieldName="ImageSource" dxg:GridColumn.GroupInterval="Alphabetical">
        </dxg:GridColumn>
      </dxg:GridControl.Columns>
      <dxg:GridControl.View>
        <dxg:CardView FrameworkElement.Name="View" dxg:CardView.CardLayout="Rows" dxg:CardView.CardTemplate="{StaticResource cardTemplate}" grid:DataViewBase.IsColumnChooserVisible="False" grid:DataViewBase.NavigationStyle="Row" grid:DataViewBase.SearchColumns="FileName" grid:DataViewBase.SearchPanelAllowFilter="True" grid:DataViewBase.SearchPanelHighlightResults="False" dxg:CardView.SeparatorThickness="0" dxg:CardView.ShowCardExpandButton="False" grid:DataViewBase.ShowColumnHeaders="False" grid:DataViewBase.ShowFilterPanelMode="Never" dxg:GridViewBase.ShowGroupPanel="False" dxg:GridViewBase.ShowGroupedColumns="False" grid:DataViewBase.ShowSearchPanelMode="Default">
        </dxg:CardView>
      </dxg:GridControl.View>
    </dxg:GridControl>
  </Grid>
</UserControl>
