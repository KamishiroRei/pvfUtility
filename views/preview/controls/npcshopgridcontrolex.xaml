<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:local="clr-namespace:PvfCode.Views.Preview.Controls;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:preview="clr-namespace:PvfCode.Views.Preview;assembly=pvfUtility" xmlns:pvfcode="clr-namespace:PvfCode;assembly=pvfUtility" Padding="0">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type dxg:GridCard}" TargetType="{x:Type dxg:GridCard}">
        <Setter Property="Control.BorderBrush" Value="{x:Null}" />
        <Setter Property="Control.BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Margin" Value="0" />
        <Setter Property="Control.Padding" Value="0" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dxg:GridCard}">
              <ContentControl Name="card" Margin="0" Padding="0">
                <interactivity:Interaction.Behaviors xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1">
                  <ui:FocusBehavior xmlns:ui="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" />
                  <ui:EventToCommand xmlns:interactivity="clr-namespace:DevExpress.Mvvm.UI.Interactivity;assembly=DevExpress.Xpf.Core.v24.1" interactivity:EventTriggerBase.EventName="MouseUp" xmlns:ui="clr-namespace:DevExpress.Mvvm.UI;assembly=DevExpress.Xpf.Core.v24.1" ui:EventToCommandBase.Command="{Binding Row.OnOpenFileCommand}" />
                </interactivity:Interaction.Behaviors>
                <Grid Width="36" Height="36" Margin="0">
                  <Image Name="imageBack" Width="36" Height="36" Source="/images/pngs/npcshop/57.png" />
                  <Border Margin="0" BorderBrush="#a64b2e" BorderThickness="0" CornerRadius="2">
                    <Image Width="30" Height="30" Source="{Binding Row.ImageSource}" />
                  </Border>
                  <Image Name="imageSealingMark" Width="32" Height="32" Opacity="1" />
                  <Image Name="imageSelected" Width="36" Height="36" Opacity="1" />
                  <flyout:FlyoutControl xmlns:flyout="clr-namespace:DevExpress.Xpf.Editors.Flyout;assembly=DevExpress.Xpf.Core.v24.1" flyout:FlyoutControl.Name="flyoutControl" Control.Padding="0" Control.Background="#00FFFFFF" Control.BorderThickness="0" FrameworkElement.FlowDirection="LeftToRight" xmlns:native="clr-namespace:DevExpress.Xpf.Editors.Flyout.Native;assembly=DevExpress.Xpf.Core.v24.1" native:FlyoutBase.StaysOpen="True" Control.BorderBrush="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=PvfFilePreviewOptions.CurrentColorConfing.PvfFilePreviewBorderBrush, Converter={StaticResource TreeColorConverterPreview}}" native:FlyoutBase.PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type flyout:FlyoutControl}">
                        <Setter Property="native:FlyoutBase.Settings">
                          <Setter.Value>
                            <flyout:FlyoutSettings flyout:FlyoutSettings.Placement="Top" flyout:FlyoutSettings.ShowIndicator="False" />
                          </Setter.Value>
                        </Setter>
                        <Setter Property="native:FlyoutBase.IsOpen" Value="False" />
                        <Setter Property="native:FlyoutBase.HorizontalOffset" Value="60" />
                      </Style>
                    </FrameworkElement.Style>
                    <Border BorderThickness="0" Focusable="False" BorderBrush="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=PvfFilePreviewOptions.CurrentColorConfing.PvfFilePreviewBorderBrush, Converter={StaticResource TreeColorConverterPreview}}">
                      <preview:PreviewPvfItemControl x:Name="previewControl" ContentEx="{Binding Row.PreviewBase}" />
                    </Border>
                  </flyout:FlyoutControl>
                </Grid>
              </ContentControl>
              <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="Control.MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <BooleanAnimationUsingKeyFrames Storyboard.TargetName="flyoutControl" Storyboard.TargetProperty="IsOpen">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.3" Value="True" />
                      </BooleanAnimationUsingKeyFrames>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Control.MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <BooleanAnimationUsingKeyFrames Storyboard.TargetName="flyoutControl" Storyboard.TargetProperty="IsOpen">
                        <DiscreteBooleanKeyFrame KeyTime="0:0:0.05" Value="False" />
                      </BooleanAnimationUsingKeyFrames>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <DataTrigger Value="True" Binding="{Binding Row.EquIsSealing}">
                  <Setter TargetName="imageSealingMark" Property="Image.Source" Value="{Binding Source={x:Static pvfcode:Res.Instance}, Path=ImageSealingMark}" />
                  <Setter TargetName="imageSealingMark" Property="UIElement.Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Value="False" Binding="{Binding Row.EquIsSealing}">
                  <Setter TargetName="imageSealingMark" Property="UIElement.Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="imageSelected" Property="Image.Source" Value="{Binding Source={x:Static pvfcode:Res.Instance}, Path=ItemImageSourceSelected}" />
                </Trigger>
                <DataTrigger Value="True" Binding="{Binding IsSelected}">
                  <Setter TargetName="imageSelected" Property="Image.Source" Value="{Binding Source={x:Static pvfcode:Res.Instance}, Path=ItemImageSourceSelected}" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="contentTemplate">
        <Grid Width="30" Height="30" Margin="0">
          <Image Width="30" Height="30" Source="/images/pngs/npcshop/57.png" />
        </Grid>
      </ControlTemplate>
      <DataTemplate x:Key="cardTemplate">
        <ContentControl Template="{StaticResource contentTemplate}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <dxg:GridControl FrameworkElement.Name="Grid" FrameworkElement.Height="auto" dxg:GridControl.AutoExpandAllGroups="True" dxg:GridControl.Background="#00FFFFFF" xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" grid:DataControlBase.SelectionMode="Row" grid:DataControlBase.ShowBorder="False" grid:DataControlBase.CurrentItem="{Binding CurrentItem}" grid:DataControlBase.ItemsSource="{Binding Path=Items.CollectionView}">
      <dxg:GridControl.Columns>
        <dxg:GridColumn grid:ColumnBase.FieldName="Icon" />
      </dxg:GridControl.Columns>
      <dxg:GridControl.View>
        <dxg:CardView FrameworkElement.Name="View" grid:DataViewBase.AllowDragDrop="False" dxg:CardView.CardLayout="Rows" dxg:CardView.CardMargin="0" grid:DataViewBase.IsColumnChooserVisible="False" grid:DataViewBase.NavigationStyle="Row" grid:DataViewBase.SearchColumns="FileName" grid:DataViewBase.SearchPanelAllowFilter="True" grid:DataViewBase.SearchPanelHighlightResults="False" dxg:CardView.SeparatorThickness="0" dxg:CardView.ShowCardExpandButton="False" grid:DataViewBase.ShowColumnHeaders="False" grid:DataViewBase.ShowDragDropHint="True" grid:DataViewBase.ShowFilterPanelMode="Never" dxg:GridViewBase.ShowGroupPanel="False" dxg:GridViewBase.ShowGroupedColumns="False" grid:DataViewBase.ShowSearchPanelMode="Default">
          <bars:BarManager.DXContextMenu xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
            <bars:PopupMenu>
              <bars:PopupMenu.Items xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
                <bars:BarButtonItem xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:BarItem.Content="复制选中代码" bars:BarItem.Glyph="{DynamicResource CopyIcon}" bars:BarItem.KeyGesture="Delete" />
                <bars:BarButtonItem bars:BarItem.Content="删除" bars:BarItem.Glyph="{DynamicResource Action_Delete}" bars:BarItem.KeyGesture="Delete" />
              </bars:PopupMenu.Items>
            </bars:PopupMenu>
          </bars:BarManager.DXContextMenu>
        </dxg:CardView>
      </dxg:GridControl.View>
    </dxg:GridControl>
  </Grid>
</UserControl>