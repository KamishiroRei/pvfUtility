                      </GridColumn>
                    </GridControl.Columns>
                  </GridControl>
                </Grid>
              </docking:LayoutPanel>
              <docking:LayoutPanel docking:BaseLayoutItem.Padding="0" docking:BaseLayoutItem.Caption="图像属性" docking:BaseLayoutItem.ClosingBehavior="HideToClosedPanelsCollection" docking:BaseLayoutItem.ItemHeight="*" />
            </docking:LayoutGroup>
          </docking:LayoutGroup>
        </docking:LayoutGroup>
      </docking:LayoutGroup>
    </docking:DockLayoutManager>
  </BarManager>
</gameimagesextract:WindowGameImageExtract>
