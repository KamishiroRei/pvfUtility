                <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <GridControl FrameworkElement.Name="ImgListGrid" p19:DataControlBase.AutoGenerateColumns="KeepOld" p19:DataControlBase.CurrentItem="{Binding CurrentIndex}" p19:DataControlBase.ItemsSource="{Binding ElementName=logListGrid, Path=CurrentItem.Value.IndexItems}" xmlns:p19="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" xmlns="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
                    <GridControl.Columns>
                      <GridColumn>
                        <p19:ColumnBase.CellTemplate>
