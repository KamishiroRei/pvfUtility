<?xml version="1.0" encoding="utf-8"?>
<gameimagesextract:WindowGameImageExtract xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:gameimageextract="clr-namespace:PvfCode.ViewModels.GameImageExtract;assembly=pvfUtility" FrameworkElement.Name="win" Window.Title="游戏图像资源工具" FrameworkElement.Width="1000" FrameworkElement.Height="800" xmlns:gameimagesextract="clr-namespace:PvfCode.Views.GameImagesExtract;assembly=pvfUtility">
  <FrameworkElement.DataContext>
    <gameimageextract:GameImageExtractViewModel />
  </FrameworkElement.DataContext>
  <BarManager xmlns="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
    <bars:BarManager.Bars xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
      <bars:Bar xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:Bar.AllowCustomizationMenu="False" bars:Bar.AllowQuickCustomization="False" bars:Bar.Caption="File" bars:Bar.IsMainMenu="False" bars:Bar.ShowDragWidget="True">
        <bars:BarButtonItem bars:BarItem.BarItemDisplayMode="ContentAndGlyph">
          <FrameworkContentElement.Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <Style TargetType="{x:Type bars:BarButtonItem}">
              <Style.Triggers>
                <DataTrigger Value="false" Binding="{Binding IsStart}">
                  <Setter Property="bars:BarItem.Content" Value="开始获取" />
                  <Setter Property="bars:BarItem.Glyph" Value="{DynamicResource RunIcon}" />
                  <Setter Property="bars:BarItem.Command" Value="{Binding OnStartCommand}" />
                  <Setter Property="bars:BarItem.CommandParameter" Value="{Binding ElementName=win}" />
                </DataTrigger>
                <DataTrigger Value="True" Binding="{Binding IsStart}">
                  <Setter Property="bars:BarItem.Content" Value="停止" />
                  <Setter Property="bars:BarItem.Glyph" Value="{DynamicResource StopIcon}" />
                  <Setter Property="bars:BarItem.Command" Value="{Binding OnStopCommand}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkContentElement.Style>
        </bars:BarButtonItem>
        <bars:BarItemSeparator />
        <bars:BarButtonItem bars:BarItem.BarItemDisplayMode="ContentAndGlyph" bars:BarItem.Content="清空" bars:BarItem.Glyph="{DynamicResource ClearWindowContent}" bars:BarItem.Command="{Binding Path=OnClearLogCommand}" />
        <bars:BarItemSeparator />
        <bars:BarItemSeparator />
      </bars:Bar>
    </bars:BarManager.Bars>
    <docking:DockLayoutManager xmlns:docking="clr-namespace:DevExpress.Xpf.Docking;assembly=DevExpress.Xpf.Docking.v24.1" docking:DockLayoutManager.Name="DemoDockContainer" Grid.Row="1" Grid.ColumnSpan="2" FrameworkElement.Margin="0,0,0,3" docking:DockLayoutManager.DisposeOnWindowClosing="False" docking:DockLayoutManager.DockingStyle="VS2010" docking:DockLayoutManager.FloatingDocumentContainer="Default" docking:DockLayoutManager.FloatingMode="Desktop" docking:DockLayoutManager.ShowFloatWindowsInTaskbar="True">
      <docking:LayoutGroup FrameworkElement.Name="Root">
        <docking:LayoutGroup docking:BaseLayoutItem.ItemWidth="3*" docking:LayoutGroup.Orientation="Vertical">
          <docking:LayoutGroup docking:BaseLayoutItem.ItemHeight="3*">
            <docking:LayoutGroup docking:BaseLayoutItem.ClosingBehavior="HideToClosedPanelsCollection" docking:BaseLayoutItem.ItemWidth="2*" docking:LayoutGroup.Orientation="Vertical">
              <docking:LayoutPanel docking:BaseLayoutItem.Padding="0" docking:BaseLayoutItem.Caption="图像列表" docking:BaseLayoutItem.ItemHeight="*">
                <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <GridControl FrameworkElement.Name="logListGrid" p19:DataControlBase.CurrentItem="{Binding CurrentLog}" p19:DataControlBase.ItemsSource="{Binding LogList}" xmlns:p19="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" xmlns="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
                    <grid:GridControl.Columns xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
                      <grid1:GridColumn xmlns:grid="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1.Core" grid:BaseColumn.Width="*" grid:BaseColumn.MinWidth="400" grid:ColumnBase.FieldName="Key" xmlns:grid1="clr-namespace:DevExpress.Xpf.Grid;assembly=DevExpress.Xpf.Grid.v24.1">
                        <grid:ColumnBase.CellTemplate>
                          <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                            <TextBox MaxHeight="70" TextWrapping="Wrap" Text="{Binding Row.Key, Mode=OneWay}" />
                          </DataTemplate>
                        </grid:ColumnBase.CellTemplate>
                      </grid1:GridColumn>
                      <grid:GridColumn p19:BaseColumn.Width="200" p19:ColumnBase.FieldName="CurrentValue" p19:BaseColumn.Header="当前值">
                        <p19:ColumnBase.CellTemplate>
                          <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                            <TextBox MaxHeight="70" TextWrapping="Wrap" Text="{Binding Row.Value.CurrentValue, Mode=OneWay}" />
                          </DataTemplate>
                        </p19:ColumnBase.CellTemplate>
                      </grid:GridColumn>
                      <grid:GridColumn p19:BaseColumn.Width="200" p19:ColumnBase.FieldName="AllValue" p19:BaseColumn.Header="全部值">
                        <p19:ColumnBase.CellTemplate>
                          <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                            <TextBox MaxHeight="70" TextWrapping="Wrap" Text="{Binding Row.Value.AllValue, Mode=OneWay}" />
                          </DataTemplate>
                        </p19:ColumnBase.CellTemplate>
                      </grid:GridColumn>
                    </grid:GridControl.Columns>
                  </GridControl>
                </Grid>
              </docking:LayoutPanel>
            </docking:LayoutGroup>
            <docking:LayoutGroup docking:FloatGroup.SizeToContent="WidthAndHeight" docking:LayoutGroup.DestroyOnClosingChildren="False" docking:BaseLayoutItem.ItemWidth="3*" docking:LayoutGroup.Orientation="Vertical" docking:BaseLayoutItem.ShowCaption="false">
              <docking:LayoutPanel docking:BaseLayoutItem.Caption="设计区" docking:BaseLayoutItem.ItemHeight="3*" docking:BaseLayoutItem.ShowCaption="False">
                <Grid Background="#FF808080" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <Image Width="{Binding CurrentImgFile.Width}" Height="{Binding CurrentImgFile.Height}" Source="{Binding CurrentImgFile.ImageSource, Mode=OneWay}" />
                </Grid>
              </docking:LayoutPanel>
              <docking:LayoutPanel docking:BaseLayoutItem.Caption="输出" />
