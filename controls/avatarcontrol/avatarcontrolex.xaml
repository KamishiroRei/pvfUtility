<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PvfCode.Controls.AvatarControl;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="avatar">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:ConvertXy x:Key="ConvertXy" />
      <local:ConvertCenter x:Key="ConvertCenter" />
      <GeometryGroup x:Key="clipGeometry" FillRule="Nonzero">
        <EllipseGeometry Center="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConvertCenter}}" RadiusX="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConvertXy}}" RadiusY="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ConvertXy}}" />
      </GeometryGroup>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Name="image1" HorizontalAlignment="Center" VerticalAlignment="Center" Clip="{StaticResource clipGeometry}" Stretch="Fill" Width="{Binding ElementName=avatar, Path=Width}" Height="{Binding ElementName=avatar, Path=Height}" Source="{Binding Path=ImageSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=local:AvatarControlEx, Mode=FindAncestor}}" />
    <Ellipse Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="2" Stroke="{Binding ElementName=avatar, Path=BorderBrush}" />
  </Grid>
</UserControl>