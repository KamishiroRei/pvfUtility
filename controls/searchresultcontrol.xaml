<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:appsetting="clr-namespace:PvfCode;assembly=PvfCode.Models" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" xmlns:local="clr-namespace:PvfCode.Controls;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:root="clr-namespace:PvfCode;assembly=pvfUtility" Padding="0" BorderThickness="0" BorderBrush="{x:Null}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <bars:BarContainerControl Grid.Row="0" xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
      <bars:Bar xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:Bar.AllowCustomizationMenu="False" bars:Bar.AllowQuickCustomization="False" bars:Bar.ShowDragWidget="True">
        <bars:BarButtonItem bars:BarItem.Glyph="{DynamicResource FindDown}" FrameworkContentElement.ToolTip="从搜索结果查找" bars:BarItem.Command="{Binding OpenSearchUICommand}" ContentElement.IsEnabled="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
        <bars:BarItemSeparator />
        <bars:BarButtonItem bars:BarItem.Glyph="{DynamicResource ExtractFilesIcon}" FrameworkContentElement.ToolTip="提取全部" bars:BarItem.Command="{Binding ExtractAllCommand}" ContentElement.IsEnabled="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
        <bars:BarItemSeparator />
        <bars:BarButtonItem bars:BarItem.Content="从txt导入搜索结果" bars:BarItem.Glyph="{DynamicResource ImportText}" bars:BarItem.Command="{Binding OnTxtImportFileListCommand}" ContentElement.IsEnabled="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
        <bars:BarButtonItem bars:BarItem.Content="搜索结果另存为.txt文本" bars:BarItem.Glyph="{DynamicResource ExportText}" bars:BarItem.Command="{Binding OnExportToTextFileCommand}" ContentElement.IsEnabled="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
        <bars:BarItemSeparator />
        <bars:BarButtonItem bars:BarItem.Content="批处理" bars:BarItem.Glyph="{DynamicResource CollapseGroup_16x}" bars:BarItem.Command="{Binding TreeViewModel.OnBatchOperationCommand}" ContentElement.IsEnabled="{Binding Source={x:Static root:AppCore.ViewModelBase}, Path=PVF.PvfIsOpen, Mode=OneWay}" />
        <bars:BarSubItem bars:BarItem.BarItemDisplayMode="ContentAndGlyph" bars:BarItem.Content="宏" bars:BarItem.Glyph="{DynamicResource MacroIcon}" bars:BarSubItem.ItemLinksSource="{Binding Source={x:Static appsetting:AppSetting.Instance}, Path=MacroGroup.Trees}" />
        <bars:BarItemSeparator />
        <bars:BarButtonItem bars:BarItem.Alignment="Far" bars:BarItem.CommandParameter="True" bars:BarItem.Content="清空所有搜索结果集" bars:BarItem.Glyph="{DynamicResource ClearWindowContent}" bars:BarItem.Command="{Binding ClearCommand}" />
      </bars:Bar>
    </bars:BarContainerControl>
    <editors:ComboBoxEdit Grid.Row="1" editors:ButtonEdit.AllowDefaultButton="False" Control.BorderThickness="1" editors:ButtonEdit.IsTextEditable="False" editors:BaseEdit.ShowBorder="True" editors:LookUpEditBase.ItemsSource="{Binding SearchReusltData.Keys}" editors:LookUpEditBase.SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
      <editors:ButtonEdit.Buttons>
        <editors:ButtonInfo editors:ButtonInfoBase.ClickMode="Press">
          <editors:ButtonInfo.Content>
            <StackPanel Orientation="Horizontal">
              <TextBlock Foreground="#FF808080">Count：</TextBlock>
              <TextBlock Foreground="#FF808080" Text="{Binding Path=DataContext.TreeViewModel.TreeGroupData.FileCount, RelativeSource={RelativeSource AncestorType=local:SearchResultControl}}" />
            </StackPanel>
          </editors:ButtonInfo.Content>
        </editors:ButtonInfo>
        <editors:ButtonInfo editors:ButtonInfoBase.Margin="2,0,0,0" editors:ButtonInfoBase.ClickMode="Press" editors:ButtonInfo.GlyphKind="DropDown" editors:ButtonInfoBase.IsDefaultButton="True" FrameworkContentElement.ToolTip="历史记录" />
        <editors:ButtonInfo FrameworkContentElement.ToolTip="新建文件集" editors:CommandButtonInfo.Command="{Binding OnShowAddNewSearchResultViewCommand}">
          <editors:ButtonInfo.Content>
            <Image Width="16" Height="16" Source="{DynamicResource NewFile_16x}" Stretch="Fill" />
          </editors:ButtonInfo.Content>
        </editors:ButtonInfo>
        <editors:ButtonInfo editors:ButtonInfoBase.Foreground="#FFFF69B4" editors:ButtonInfo.GlyphKind="Cancel" FrameworkContentElement.ToolTip="清空当前搜索结果集" editors:CommandButtonInfo.Command="{Binding RemoveSelectedSearchResultCommand}" />
      </editors:ButtonEdit.Buttons>
    </editors:ComboBoxEdit>
    <local:PvfTreeViewGroup Grid.Row="2" DataContext="{Binding TreeViewModel}" />
  </Grid>
</UserControl>
