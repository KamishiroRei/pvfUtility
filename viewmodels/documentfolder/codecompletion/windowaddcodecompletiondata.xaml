      <editors:ComboBoxEdit Grid.Column="1" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:ButtonEdit.IsTextEditable="False" editors:BaseEdit.EditValue="{Binding Data.CodeCompletScriptType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" editors:LookUpEditBase.ItemsSource="{Binding Source={StaticResource KeyCodeCompletScriptType}}">
        <editors:BaseEdit.EditValueChanged>
