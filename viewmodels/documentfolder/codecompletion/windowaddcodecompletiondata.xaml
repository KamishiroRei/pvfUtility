      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
        <CheckBox Name="checkIsShare" Margin="0,0,10,0" Content="{DynamicResource CodeCompletionToolTip_CheckBox_Share}" IsChecked="{Binding Data.IsShare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
