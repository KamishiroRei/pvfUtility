          <x:TypeExtension TypeName="enums:CodeCompletScriptType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="ValueCodeCompletScriptType" MethodName="GetValues" ObjectType="{x:Type Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="enums:CodeCompletScriptType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
    </ResourceDictionary>
