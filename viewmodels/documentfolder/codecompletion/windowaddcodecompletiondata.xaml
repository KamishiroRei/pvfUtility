    <layoutcontrol:GroupBox Grid.Row="2" FrameworkElement.Margin="0,10,0,10" Control.Padding="0" HeaderedContentControlBase.Header="{DynamicResource WindowAddCodeCompletionData_GroupBoxHeader_CompleteText}" xmlns:layoutcontrol="clr-namespace:DevExpress.Xpf.LayoutControl;assembly=DevExpress.Xpf.LayoutControl.v24.1" layoutcontrol:GroupBox.ShowShadow="Always" UIElement.Visibility="Visible">
      <texteditlib:TextEdit Control.Padding="0" texteditlib:TextEdit.EditorType="Search" xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit" avalonedit:TextEditor.HorizontalScrollBarVisibility="Auto" avalonedit:TextEditor.ShowLineNumbers="False" avalonedit:TextEditor.Document="{Binding Document, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" avalonedit:TextEditor.SyntaxHighlighting="{Binding Highlighting, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
    </layoutcontrol:GroupBox>
    <GroupBox Grid.Row="3" FrameworkElement.Margin="0,10,0,10" Control.Padding="0" HeaderedContentControlBase.Header="{DynamicResource WindowAddCodeCompletionData_GroupBoxHeader_Description}" p14:GroupBox.ShowShadow="Always" UIElement.Visibility="Visible" xmlns:p14="clr-namespace:DevExpress.Xpf.LayoutControl;assembly=DevExpress.Xpf.LayoutControl.v24.1" xmlns="clr-namespace:DevExpress.Xpf.LayoutControl;assembly=DevExpress.Xpf.LayoutControl.v24.1">
      <texteditlib:TextEdit Control.Padding="0" texteditlib:TextEdit.EditorType="Search" p16:TextEditor.HorizontalScrollBarVisibility="Auto" p16:TextEditor.ShowLineNumbers="False" p16:TextEditor.Document="{Binding TextDocumentDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" p16:TextEditor.SyntaxHighlighting="{Binding Highlighting, Mode=OneWay}" xmlns:p16="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit" />
