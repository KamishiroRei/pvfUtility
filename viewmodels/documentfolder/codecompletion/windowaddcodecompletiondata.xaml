        <Button Width="70" Margin="0,0,10,0" Content="{DynamicResource CodeCompletionToolTip_Btn_Save}" Command="{Binding OnSaveCommand}" />
        <Button Width="70" Content="{DynamicResource common_Cancel}">
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</codecompletion:WindowAddCodeCompletionData>