  <FrameworkElement.Resources>
    <ResourceDictionary>
      <windowaddcodecompletiondata:ConverterWindowAddCodeCompletionDataShareLabelVisibility x:Key="ConverterWindowAddCodeCompletionDataShareLabelVisibility" />
      <ObjectDataProvider x:Key="KeyCodeCompletScriptType" MethodName="GetNames" xmlns:system="clr-namespace:System;assembly=System.Runtime" ObjectType="{x:Type system:Enum}">
