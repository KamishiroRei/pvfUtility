<?xml version="1.0" encoding="utf-8"?>
<local:PopupEx xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:local="clr-namespace:PvfCode.ViewModels.DocumentFolder.CodeCompletion;assembly=pvfUtility" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:texteditlib="clr-namespace:TextEditLib;assembly=TextEditLib" xmlns:texteditorfolder="clr-namespace:PvfCode.Controls.TextEditorFolder;assembly=pvfUtility" MinWidth="250" MinHeight="40">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource CompletionCommentEditorBackBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <TabControl Padding="0" Background="{DynamicResource CompletionCommentEditorBackBrush}" BorderThickness="1" TabStripPlacement="Bottom" SelectedIndex="{Binding TabControlSelectedIndex, Mode=TwoWay}">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type TabPanel}" TargetType="{x:Type TabPanel}">
            <Setter Property="Background" Value="{DynamicResource CompletionCommentTooltipTabControlBottomBackBrush}" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <TabItem Header="{DynamicResource CodeCompletionToolTip_TabItemHeader_Comment}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <texteditlib:TextEdit texteditlib:TextEdit.Name="editor" FrameworkElement.MaxHeight="800" FrameworkElement.Margin="10" Control.Background="{DynamicResource CompletionCommentEditorBackBrush}" texteditlib:TextEdit.EditorCurrentLineBackground="{DynamicResource CompletionCommentEditorBackBrush}" texteditlib:TextEdit.EditorCurrentLineBorderThickness="0" texteditlib:TextEdit.EditorType="ToolTip" xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit" avalonedit:TextEditor.ShowLineNumbers="False" avalonedit:TextEditor.Document="{Binding Document}" avalonedit:TextEditor.IsReadOnly="{Binding IsEditorComment, Converter={StaticResource ConverterBoolenToFalse}}" avalonedit:TextEditor.SyntaxHighlighting="{Binding Highlighting, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
            <FrameworkElement.Loaded>
              <dxbinding:DXEventExtension xmlns:dxbinding="clr-namespace:DevExpress.Xpf.DXBinding;assembly=DevExpress.Xpf.Core.v24.1" dxbinding:DXEventExtension.Handler="Loaded(@sender)" />
            </FrameworkElement.Loaded>
          </texteditlib:TextEdit>
          <Grid Row="1" Background="{DynamicResource TextEditorCommentAuthorsGridBackBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <TextBlock Margin="5,2,0,2" VerticalAlignment="Center" Foreground="#FF808080" Text="{DynamicResource CodeCompletionToolTip_TextBlock_Author}" />
              <TextBlock Margin="0,2,0,2" VerticalAlignment="Center" Foreground="#FF808080" Text="{Binding Comment.Authors}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <TextBlock Margin="0,2,0,2" VerticalAlignment="Center" Foreground="#FF808080" Text="update：" />
              <TextBlock Margin="0,2,0,2" VerticalAlignment="Center" Foreground="#FF808080" Text="{Binding Comment.UpdateTime, StringFormat=yyyy-MM-dd}" />
              <editors:HyperlinkEdit FrameworkElement.HorizontalAlignment="Right" FrameworkElement.VerticalAlignment="Center" xmlns:editors="clr-namespace:DevExpress.Xpf.Editors;assembly=DevExpress.Xpf.Core.v24.1" editors:HyperlinkEdit.AllowAutoNavigate="False" BaseEdit.EditValue="{DynamicResource CodeCompletionToolTip_Btn_EditComment}" FrameworkElement.ToolTip="{DynamicResource CodeCompletionToolTip_Btn_EditComment}" editors:HyperlinkEdit.Command="{Binding OnEditorSetIsEditorCommentCommand}" />
            </StackPanel>
          </Grid>
          <Grid Row="2" Background="{DynamicResource CompletionCommentEditorBackBrush}" Visibility="{Binding IsEditorComment, Converter={StaticResource ConvertBoolenToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Content="{DynamicResource CodeCompletionToolTip_CheckBox_Share}" Cursor="Hand" IsChecked="{Binding IsShare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Grid.Column="1" Margin="9,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{DynamicResource CodeCompletionToolTip_Label_NickName}" />
            <TextBox Grid.Column="2" Text="{Binding NickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <bars:ToolBarControl Grid.Column="3" xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" bars:ToolBarControlBase.AllowCustomizationMenu="False" bars:ToolBarControl.AllowQuickCustomization="False" Control.Background="{DynamicResource CompletionCommentEditorBackBrush}" bars:ToolBarControl.ShowDragWidget="True" bars:ToolBarControl.UseWholeRow="True">
              <bars:BarButtonItem BarItem.Content="{DynamicResource CodeCompletionToolTip_Btn_Save}" FrameworkContentElement.Cursor="Hand" BarItem.Glyph="{DynamicResource SaveStatusBar}" bars:BarItem.Command="{Binding SavePvfCommentCommand}" />
            </bars:ToolBarControl>
          </Grid>
          <ProgressBar Grid.Row="0" Height="24" VerticalAlignment="Center" BorderThickness="0" Foreground="{DynamicResource TreeLoadingProgressForeground}" IsIndeterminate="True" Style="{StaticResource ProgressVs}" BorderBrush="{x:Null}" Visibility="{Binding IsLoading, Converter={StaticResource ConvertBoolenToVisibility}}" />
        </Grid>
      </TabItem>
      <TabItem Header="编辑自动完成">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <texteditlib:TextEdit texteditlib:TextEdit.Name="editorAuto" FrameworkElement.MaxHeight="800" FrameworkElement.Margin="10" Control.Background="{DynamicResource CompletionCommentEditorBackBrush}" texteditlib:TextEdit.EditorCurrentLineBackground="{DynamicResource CompletionCommentEditorBackBrush}" texteditlib:TextEdit.EditorCurrentLineBorderThickness="0" texteditlib:TextEdit.EditorType="ToolTip" p14:TextEditor.ShowLineNumbers="False" p14:TextEditor.Document="{Binding DocumentAutoText}" p14:TextEditor.SyntaxHighlighting="{Binding Highlighting, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" xmlns:p14="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit">
          </texteditlib:TextEdit>
          <Grid Row="1" Background="{DynamicResource TextEditorCommentAuthorsGridBackBrush}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="5,2,0,2" Foreground="#FF808080" Text="{DynamicResource CodeCompletionToolTip_TextBlock_Author}" />
              <TextBlock Margin="0,2,0,2" Foreground="#FF808080" Text="{Binding Comment.Authors}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <TextBlock Margin="0,2,0,2" Foreground="#FF808080" Text="update：" />
              <TextBlock Margin="0,2,0,2" Foreground="#FF808080" Text="{Binding Comment.UpdateTime, StringFormat=yyyy-MM-dd}" />
            </StackPanel>
          </Grid>
          <ToolBarControl Grid.Row="1" p14:ToolBarControlBase.AllowCustomizationMenu="False" p14:ToolBarControl.AllowQuickCustomization="False" Control.Background="{DynamicResource CompletionCommentEditorBackBrush}" p14:ToolBarControl.ShowDragWidget="True" p14:ToolBarControl.UseWholeRow="True" xmlns:p14="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" xmlns="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
            <bars:BarStaticItem xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1">
              <bars:BarItem.ContentTemplate>
                <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <CheckBox Name="CheckIsShare" Content="{DynamicResource CodeCompletionToolTip_CheckBox_Share}" ToolTip="{DynamicResource CodeCompletionToolTip_CheckBox_ShareToolTip}" IsChecked="{Binding Path=DataContext.CompletionDataIsShare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=dxb:ToolBarControl}}" />
                </DataTemplate>
              </bars:BarItem.ContentTemplate>
            </bars:BarStaticItem>
            <bars:BarItemSeparator xmlns:bars="clr-namespace:DevExpress.Xpf.Bars;assembly=DevExpress.Xpf.Core.v24.1" />
            <p14:BarStaticItem p14:BarStaticItem.AutoSizeMode="Fill" p14:BarStaticItem.ContentAlignment="Stretch" p14:BarStaticItem.ShowBorder="False" ContentElement.IsEnabled="{Binding CompletionDataIsShare}">
              <p14:BarItem.ContentTemplate>
                <DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource CodeCompletionToolTip_Label_NickName}" />
                    <TextBox Grid.Column="1" IsReadOnly="False" BorderBrush="{x:Null}" Text="{Binding Path=DataContext.NickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=dxb:ToolBarControl}}" />
                  </Grid>
                </DataTemplate>
              </p14:BarItem.ContentTemplate>
            </p14:BarStaticItem>
            <p14:BarButtonItem p14:BarItem.Content="{DynamicResource CodeCompletionToolTip_Btn_Save}" p14:BarItem.Glyph="{DynamicResource SaveStatusBar}" p14:BarItem.Command="{Binding SaveCodeCompleDataCommand}" />
          </ToolBarControl>
          <ProgressBar Grid.Row="0" Height="24" VerticalAlignment="Center" BorderThickness="0" Foreground="{DynamicResource TreeLoadingProgressForeground}" IsIndeterminate="True" Style="{StaticResource ProgressVs}" BorderBrush="{x:Null}" Visibility="{Binding IsLoading, Converter={StaticResource ConvertBoolenToVisibility}}" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</local:PopupEx>