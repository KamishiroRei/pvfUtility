<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cc="clr-namespace:PvfCode.ViewModels.DocumentFolder.CodeCompletion;assembly=pvfUtility">
  <Style x:Key="CompletionListBoxItem" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="true">
            <Grid>
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ListBoxItem.IsSelected" Value="true">
              <Setter Value="{DynamicResource CompletionListSelectItemBackBrush}" Property="Background" />
              <Setter Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ListBoxItemWithPopup" TargetType="{x:Type ListBoxItem}">
    <Border Name="border" Padding="2">
      <StackPanel Height="18" Orientation="Horizontal">
        <Popup Name="popup" IsOpen="True" Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
          <TextBlock Margin="1" Background="#FFFFFFFF" Foreground="#FF000000" Text="666666666" />
        </Popup>
        <Image Width="16" Height="16" Margin="0,0,2,0" Source="{Binding Image}" />
        <TextBlock VerticalAlignment="Center" Text="{Binding Text}" />
      </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="ListBoxItem.IsSelected" Value="true">
        <Setter TargetName="popup" Property="Popup.IsOpen" Value="True" />
        <Setter TargetName="border" Property="Border.Background" Value="#FFF0FFFF" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="{x:Type cc:CompletionList}" TargetType="{x:Type cc:CompletionList}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type cc:CompletionList}">
          <cc:CompletionListBox x:Name="PART_ListBox" Background="{TemplateBinding Control.Background}" TextBlock.Foreground="{TemplateBinding Control.Foreground}" ItemContainerStyle="{StaticResource CompletionListBoxItem}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Height="18" Orientation="Horizontal">
                  <Image Width="16" Height="16" Margin="0,0,2,0" Source="{Binding Image}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </cc:CompletionListBox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>